{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "property-radar-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // D1 分库绑定（TASK-02A 已创建，schema 见 db/migrations/{public,private}/）
  "d1_databases": [
    { "binding": "DB_PUBLIC", "database_name": "radar_public", "database_id": "ae8a0143-f3ca-4141-ba15-754ccdb15fff" },
    { "binding": "DB_PRIVATE", "database_name": "radar_private", "database_id": "c94227fc-b557-4bf1-ad3e-e929bf1820ab" }
  ],
  // 非敏感配置（PRD 附录 A：这些是 vars，不得作为 Secret 混淆）；
  // Secrets（SESSION_SIGNING_SECRET / TURNSTILE_SECRET_KEY / APPS_SCRIPT_* / INGEST_HMAC_SECRET ）用 wrangler secret put
  "vars": {
    "EMAIL_PROVIDER": "google_apps_script_mail",
    "EMAIL_DAILY_HARD_CAP": "80",
    "OTP_DAILY_RESERVED_CAP": "60"
  },
  // TASK-05A §6.6：每日系统事件评估（更新延迟/数据异常）——UTC 00:30 = 北京 08:30
  "triggers": { "crons": ["30 0 * * *", "30 23 * * *"] }, // 北京08:30事件评估（05A）+ 北京07:30每日摘要（05B）
  "observability": { "enabled": true }
}
