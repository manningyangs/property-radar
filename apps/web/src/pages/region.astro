---
/**
 * 区县详情 `/region?id=`（PRD 2.4）：
 * 行政路径、二手房/成交/新房分栏、价格口径与周期切换、同级比较、
 * 区县内小区列表、加入监控（游客 → Permission 引导）。
 * 静态构建通过 query 参数由客户端脚本选择对象（默认第一个）。
 */
import AppShell from "../layouts/AppShell.astro";
import EmptyState from "../components/EmptyState.astro";
import PriceMetricCard from "../components/PriceMetricCard.astro";
import ConfirmDialog from "../components/ConfirmDialog.astro";
import CommunityCard from "../components/CommunityCard.astro";
import SourceAttribution from "../components/SourceAttribution.astro";
import SampleCountLabel from "../components/SampleCountLabel.astro";
import { PERIOD_LABELS } from "../scripts/chart";

const demoEnabled = import.meta.env.PUBLIC_DEMO_DATA === "1";
const demo = demoEnabled ? (await import("../data/demo")).demoData : null;

const periodKeys = ["7", "30", "90", "180", "360"];

const chartMap: Record<string, Record<string, Record<string, number[]>>> = {};
if (demo) {
  for (const region of demo.regions) {
    chartMap[region.id] = { list: region.series, deal: region.dealSeries };
  }
}
const chartJson = JSON.stringify(chartMap);

const statusBadge = (status: string) =>
  status === "stale"
    ? { text: "数据延迟", cls: "badge--warning" }
    : status === "low"
      ? { text: "样本有限", cls: "badge--warning" }
      : status === "none"
        ? { text: "未覆盖", cls: "badge--neutral" }
        : { text: "数据正常", cls: "badge--down" };
---

<AppShell title="区县详情" activeTab="regions" demo={demoEnabled} backHref="/regions">
  {
    demo ? (
      <div class="page" data-chart-json={chartJson}>
        {/* 分栏：二手房 / 成交 / 新房 */}
        <div class="chip-row" role="group" aria-label="数据分栏">
          <button type="button" class="chip is-active" data-pane="second" aria-pressed="true">
            二手房
          </button>
          <button type="button" class="chip" data-pane="deal" aria-pressed="false">
            成交
          </button>
          <button type="button" class="chip" data-pane="newhouse" aria-pressed="false">
            新房
          </button>
        </div>

        <div class="stack region-detail-blocks">
          {demo.regions.map((region, index) => {
            const badge = statusBadge(region.status);
            const listDirection = region.direction;
            const dealDirection =
              region.dealChange > 0 ? "up" : region.dealChange < 0 ? "down" : "flat";
            const peers = demo.regions.filter((item) => item.id !== region.id);
            const communities = demo.communities.filter(
              (item) => item.regionId === region.id,
            );
            return (
              <section
                class:list={["card", "region-detail", index !== 0 && "is-hidden"]}
                data-region-detail={region.id}
                aria-label={region.name}
              >
                <div class="rd-head">
                  <div>
                    <h2 class="rd-name">{region.name}</h2>
                    <p class="meta">
                      {region.city} › {region.name}
                    </p>
                  </div>
                  <span class:list={["badge", badge.cls]}>{badge.text}</span>
                </div>

                <div data-pane-panel="second">
                  <PriceMetricCard
                    metric="二手房 · 挂牌参考中位价"
                    value={region.listMedian.toLocaleString("zh-CN")}
                    direction={listDirection}
                    percent={region.listChange}
                    statDate="2026-11-10"
                    sample={region.listSample}
                    status={
                      region.status === "stale"
                        ? { text: "数据延迟", tone: "warning" }
                        : { text: "数据正常", tone: "ok" }
                    }
                    footer={`挂牌均价 ${region.listAvg.toLocaleString("zh-CN")} 元/㎡ · 质量等级 ${region.quality}`}
                  />
                </div>

                <div data-pane-panel="deal" class="is-hidden">
                  <PriceMetricCard
                    metric="二手房 · 实际成交中位价"
                    value={region.dealMedian.toLocaleString("zh-CN")}
                    direction={dealDirection}
                    percent={region.dealChange}
                    statDate="2026-11-10"
                    sample={region.dealSample}
                    status={{ text: "口径独立呈现", tone: "neutral" }}
                    footer="仅授权数据支持成交口径；与挂牌口径分别呈现，禁止混比。"
                  />
                </div>

                <div data-pane-panel="newhouse" class="is-hidden">
                  <EmptyState
                    title="新房口径暂未接入"
                    description="该区县暂无合格新房数据源。未覆盖口径不展示虚构数字，可提交覆盖申请。"
                    actionText="登录后提交覆盖申请"
                    actionHref="/login"
                  />
                </div>

                <div data-chart-area>
                  <figure class="rd-chart-wrap">
                    <svg
                      class="rd-chart"
                      viewBox="0 0 100 72"
                      preserveAspectRatio="none"
                      data-chart
                      role="img"
                      aria-label="区县价格趋势图"
                    >
                      <line
                        x1="0"
                        y1="71"
                        x2="100"
                        y2="71"
                        stroke="var(--color-border)"
                        stroke-width="1"
                        vector-effect="non-scaling-stroke"
                      />
                      <path
                        data-chart-path
                        d=""
                        fill="none"
                        stroke="var(--color-primary)"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        vector-effect="non-scaling-stroke"
                      />
                      <circle data-chart-dot cx="0" cy="0" r="0" fill="var(--color-primary)" />
                    </svg>
                    <figcaption class="meta" data-chart-caption />
                  </figure>

                  <div class="chip-row rd-periods" role="group" aria-label="趋势周期">
                    {periodKeys.map((period) => (
                      <button
                        type="button"
                        class:list={["chip", period === "30" && "is-active"]}
                        data-period={period}
                        aria-pressed={period === "30" ? "true" : "false"}
                      >
                        {PERIOD_LABELS[period]}
                      </button>
                    ))}
                  </div>

                  <div class="rd-quality">
                    <SampleCountLabel sample={region.listSample} />
                  </div>
                </div>

                {/* 同级比较：同口径同周期 */}
                <div class="rd-peers">
                  <p class="rd-subtitle">同级比较（挂牌参考 · 近 30 日 · 同口径）</p>
                  <div class="stack-sm">
                    {peers.map((peer) => (
                      <a
                        class="rd-peer"
                        href={`/region?id=${encodeURIComponent(peer.id)}`}
                        data-peer-link={peer.id}
                      >
                        <span>{peer.name}</span>
                        <span class="num">
                          {peer.listMedian.toLocaleString("zh-CN")} 元/㎡
                        </span>
                        <span
                          class:list={[
                            "badge",
                            peer.direction === "up"
                              ? "badge--up"
                              : peer.direction === "down"
                                ? "badge--down"
                                : "badge--neutral",
                          ]}
                        >
                          {peer.direction === "up" ? "▲" : peer.direction === "down" ? "▼" : "—"}{" "}
                          {Math.abs(peer.listChange).toFixed(1)}%
                        </span>
                      </a>
                    ))}
                  </div>
                </div>

                {/* 区县内小区 */}
                <div class="rd-subtitle-row">
                  <p class="rd-subtitle">区内小区</p>
                </div>
                <div class="stack-sm">
                  {communities.map((item) => (
                    <CommunityCard
                      id={item.id}
                      name={item.name}
                      regionName={item.regionName}
                      plate={item.plate}
                      median={item.median}
                      change30={item.change30}
                      direction={item.direction}
                      sample={item.sample}
                      statDate={item.statDate}
                      source={item.source}
                      status={item.status}
                    />
                  ))}
                </div>

                <SourceAttribution
                  metric="挂牌参考 / 实际成交（分口径）"
                  source="演示数据源A / 演示数据源B（演示）"
                  statDate="2026-11-10"
                  collectedAt="2026-11-10 06:10"
                  quality={region.quality}
                />

                <div class="btn-row">
                  <button
                    type="button"
                    class="btn btn--primary btn--block"
                    data-dialog-open="perm-watch"
                  >
                    加入监控（登录后云端同步）
                  </button>
                </div>
              </section>
            );
          })}
        </div>

        <ConfirmDialog
          id="perm-watch"
          title="云端监控需要登录"
          message="游客可本地浏览；注册登录后可云端保存监控清单并跨设备同步，事件通知不依赖浏览器推送权限。"
          confirmText="去登录"
          cancelText="继续浏览"
        />
      </div>
    ) : (
      <div class="page" data-prod-region>
        <p class="meta is-hidden" data-rg-loading>正在加载区县数据…</p>

        <section class="card region-detail is-hidden" data-rg-card aria-label="区县详情">
          <div class="rd-head">
            <div>
              <h2 class="rd-name" data-rg-name>—</h2>
              <p class="meta" data-rg-path></p>
            </div>
            <span class="badge badge--neutral" data-rg-freshness>—</span>
          </div>

          <div class="stack-sm" data-rg-metrics></div>
          <p class="meta is-hidden" data-rg-metrics-empty>
            该区县尚无有效价格快照；不展示任何估算数字。有合格数据后会第一时间出现在这里。
          </p>

          <p class="meta rd-source" data-rg-source></p>

          <div class="btn-row">
            <a class="btn btn--secondary" href="/communities" data-rg-communities>
              区内小区 ›
            </a>
            <button
              type="button"
              class="btn btn--primary"
              data-dialog-open="perm-watch"
            >
              加入监控（登录后云端同步）
            </button>
          </div>
        </section>

        <div class="is-hidden" data-rg-empty>
          <EmptyState
            title="未找到该区县"
            description="链接可能已过期或区县不在当前目录中；请从区域页重新选择。"
            actionText="返回区域列表"
            actionHref="/regions"
          />
        </div>

        <div class="is-hidden" data-rg-error>
          <EmptyState
            title="区县数据加载失败"
            description="无法连接数据服务，恢复之前不会展示任何区域行情。"
          >
            <button type="button" class="btn btn--secondary" data-rg-retry>
              重新加载
            </button>
          </EmptyState>
        </div>

        <ConfirmDialog
          id="perm-watch"
          title="云端监控需要登录"
          message="游客可浏览全部公开数据；云端保存监控清单与跨设备同步需注册登录。"
          confirmText="去登录"
          cancelText="继续浏览"
        />
      </div>
    )
  }
</AppShell>

<script>
  import { PERIOD_LABELS, drawChart, parseChartData } from "../scripts/chart";

  const data = parseChartData(
    document.querySelector<HTMLElement>("[data-chart-json]")?.dataset.chartJson ?? "{}",
  );

  const params = new URLSearchParams(window.location.search);
  let regionId = params.get("id") ?? "";
  if (!data[regionId]) regionId = Object.keys(data)[0] ?? "";

  let pane: "second" | "deal" | "newhouse" = "second";
  let period = "30";

  const metricKey = () => (pane === "deal" ? "deal" : "list");
  const metricLabel = () =>
    pane === "deal" ? "实际成交 · 中位价" : "挂牌参考 · 中位价";

  const applyRegion = (id: string, updateUrl: boolean) => {
    if (!data[id]) return;
    regionId = id;
    document.querySelectorAll<HTMLElement>("[data-region-detail]").forEach((block) => {
      block.classList.toggle("is-hidden", (block.dataset.regionDetail ?? "") !== id);
    });
    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set("id", id);
      window.history.replaceState({}, "", url);
    }
    redraw();
  };

  const redraw = () => {
    const block = document.querySelector<HTMLElement>(
      `[data-region-detail="${CSS.escape(regionId)}"]`,
    );
    if (!block) return;
    const svg = block.querySelector<SVGSVGElement>("[data-chart]");
    const caption = block.querySelector<HTMLElement>("[data-chart-caption]");
    const points = data[regionId]?.[metricKey()]?.[period] ?? [];
    if (svg) drawChart(svg, points);
    if (caption) {
      caption.textContent = `${metricLabel()} · ${PERIOD_LABELS[period] ?? period} · 数据来源 演示数据源汇总 · 统计日期 2026-11-10`;
    }
  };

  const applyPane = (next: "second" | "deal" | "newhouse") => {
    pane = next;
    document.querySelectorAll<HTMLElement>("[data-pane]").forEach((chip) => {
      const active = chip.dataset.pane === next;
      chip.classList.toggle("is-active", active);
      chip.setAttribute("aria-pressed", active ? "true" : "false");
    });
    document.querySelectorAll<HTMLElement>("[data-pane-panel]").forEach((panel) => {
      panel.classList.toggle("is-hidden", (panel.dataset.panePanel ?? "") !== next);
    });
    // 新房无口径：隐藏趋势图与周期切换，避免“空曲线”
    document.querySelectorAll<HTMLElement>("[data-chart-area]").forEach((area) => {
      area.classList.toggle("is-hidden", next === "newhouse");
    });
    redraw();
  };

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;

    const paneChip = target.closest<HTMLElement>("[data-pane]");
    if (paneChip) {
      const value = paneChip.dataset.pane;
      if (value === "second" || value === "deal" || value === "newhouse") applyPane(value);
      return;
    }

    const periodChip = target.closest<HTMLElement>("[data-period]");
    if (periodChip) {
      period = periodChip.dataset.period ?? "30";
      document.querySelectorAll<HTMLElement>("[data-period]").forEach((chip) => {
        const active = chip.dataset.period === period;
        chip.classList.toggle("is-active", active);
        chip.setAttribute("aria-pressed", active ? "true" : "false");
      });
      redraw();
      return;
    }

    const peer = target.closest<HTMLElement>("[data-peer-link]");
    if (peer) {
      event.preventDefault();
      applyRegion(peer.dataset.peerLink ?? "", true);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });

  window.addEventListener("app:confirm", (event) => {
    const detail = (event as CustomEvent<{ id: string }>).detail;
    if (detail.id === "perm-watch") window.location.href = "/login";
  });

  applyRegion(regionId, false);
  applyPane("second");

  // ===== TASK-08C R3：生产区县详情（GET /public/regions/:id/summary） =====
  const prodRoot = document.querySelector<HTMLElement>("[data-prod-region]");
  if (prodRoot) {
    const { ApiError, getRegionSummary, getMethodologySources } = await import("../lib/api");
    const { formatPriceValue, freshnessStatus, isLowSample, latestPerMetric, metricLabel, priceTypeLabel } =
      await import("../lib/market");
    const { readStoredCity } = await import("../lib/city");

    const loadingEl = prodRoot.querySelector<HTMLElement>("[data-rg-loading]");
    const cardEl = prodRoot.querySelector<HTMLElement>("[data-rg-card]");
    const emptyEl = prodRoot.querySelector<HTMLElement>("[data-rg-empty]");
    const errorEl = prodRoot.querySelector<HTMLElement>("[data-rg-error]");

    const show = (target: "loading" | "card" | "empty" | "error") => {
      loadingEl?.classList.toggle("is-hidden", target !== "loading");
      cardEl?.classList.toggle("is-hidden", target !== "card");
      emptyEl?.classList.toggle("is-hidden", target !== "empty");
      errorEl?.classList.toggle("is-hidden", target !== "error");
    };

    const QUALITY_TEXT: Record<string, string> = {
      valid: "质量正常",
      suspect: "质量待核",
      stale: "质量过期",
    };

    const regionIdParam = new URLSearchParams(window.location.search).get("id") ?? "";

    const load = async () => {
      if (!regionIdParam) {
        emptyEl
          ?.querySelector("h2")
          ?.replaceChildren("请从区域页选择区县");
        show("empty");
        return;
      }
      show("loading");
      try {
        const [{ region, snapshots }, sourcesRes] = await Promise.all([
          getRegionSummary(regionIdParam),
          getMethodologySources().catch(() => null),
        ]);
        if (prodRoot.querySelector("[data-rg-name]")) {
          (prodRoot.querySelector("[data-rg-name]") as HTMLElement).textContent = region.name;
        }
        const scope = readStoredCity();
        const cityName =
          scope?.city_code === region.city_code ? scope.name : region.city_code;
        prodRoot.querySelector("[data-rg-path]")!.textContent = `${cityName} › ${region.name}`;
        prodRoot.querySelector("[data-rg-communities]")!.setAttribute(
          "href",
          `/communities?region_id=${encodeURIComponent(regionIdParam)}`,
        );

        const latest = latestPerMetric(snapshots);
        const metricsHost = prodRoot.querySelector("[data-rg-metrics]")!;
        const metricsEmpty = prodRoot.querySelector("[data-rg-metrics-empty]")!;
        if (latest.length === 0) {
          metricsHost.replaceChildren();
          metricsEmpty.classList.remove("is-hidden");
        } else {
          metricsEmpty.classList.add("is-hidden");
          const fragment = document.createDocumentFragment();
          for (const s of latest) {
            const card = document.createElement("div");
            card.className = "card prod-metric-card";
            card.innerHTML = `
              <div class="prod-metric-head"><span data-m></span><span class="badge badge--neutral" data-q></span></div>
              <div class="prod-metric-value"><span class="num" data-v></span><span class="meta" data-u></span></div>
              <p class="meta prod-metric-sub" data-sub></p>`;
            card.querySelector("[data-m]")!.textContent =
              `${metricLabel(s.metric_code)} · ${priceTypeLabel(s.price_type)}`;
            card.querySelector("[data-q]")!.textContent =
              QUALITY_TEXT[s.quality_status] ?? s.quality_status;
            const valueEl = card.querySelector("[data-v]")!;
            valueEl.textContent = formatPriceValue(s.median, "元/㎡");
            if (isLowSample(s.sample_count)) valueEl.classList.add("prod-metric-value--weak");
            card.querySelector("[data-u]")!.textContent = isLowSample(s.sample_count)
              ? "低样本，仅供观察"
              : "中位价";
            card.querySelector("[data-sub]")!.textContent =
              `数据日期 ${s.stat_date.slice(0, 10)} · 样本 ${s.sample_count ?? "—"} 条 · 口径 ${s.metric_code}`;
            fragment.append(card);
          }
          metricsHost.replaceChildren(fragment);
        }

        // 新鲜度徽章：取最新快照日期；无快照如实“暂无数据”，不冒充过期结论
        const freshest = snapshots.reduce(
          (acc, s) => (s.stat_date > acc ? s.stat_date : acc),
          "",
        );
        const badge = prodRoot.querySelector("[data-rg-freshness]")!;
        if (!freshest) {
          badge.textContent = "暂无数据";
          badge.className = "badge badge--neutral";
        } else {
          const fresh = freshnessStatus(freshest, Date.now());
          badge.textContent =
            fresh === "fresh" ? "数据正常" : fresh === "delayed" ? "更新延迟" : "数据过期";
          badge.className = `badge ${fresh === "fresh" ? "badge--primary" : "badge--warning"}`;
        }

        const sourceNames = (sourcesRes?.items ?? [])
          .map((item) => item.name)
          .filter(Boolean);
        prodRoot.querySelector("[data-rg-source]")!.textContent = sourceNames.length > 0
          ? `数据来源：${sourceNames.join("、")}；口径与许可详见数据说明页。`
          : "数据来源与口径详见数据说明页。";

        show("card");
      } catch (error) {
        if (error instanceof ApiError && error.status === 404) show("empty");
        else show("error");
      }
    };

    prodRoot
      .querySelector<HTMLButtonElement>("[data-rg-retry]")
      ?.addEventListener("click", () => void load());
    void load();
  }
</script>

<style>
  .region-detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .rd-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-1);
  }

  .rd-name {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-brand-900);
    line-height: var(--line-tight);
  }

  .rd-chart-wrap {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .rd-chart {
    display: block;
    width: 100%;
    height: 72px;
    border-radius: var(--radius-input);
    background: linear-gradient(
      180deg,
      rgb(234 242 255 / 45%) 0%,
      rgb(234 242 255 / 0%) 100%
    );
  }

  .rd-periods {
    margin-top: var(--space-1);
  }

  .rd-subtitle {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-brand-900);
  }

  .rd-subtitle-row {
    margin-top: 4px;
  }

  .rd-peers {
    border-top: 1px dashed var(--color-border);
    padding-top: var(--space-1);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .rd-peer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
    min-height: var(--hit-target);
    padding: 0 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-input);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .rd-peer:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .rd-source {
    margin: 0;
  }

  /* TASK-08C：生产指标卡（脚本动态生成，节点无作用域属性） */
  :global(.prod-metric-card) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.prod-metric-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  :global(.prod-metric-value) {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  :global(.prod-metric-value .num) {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-brand-900);
  }

  :global(.prod-metric-value--weak) {
    color: var(--color-muted);
    font-weight: var(--weight-medium);
  }

  :global(.prod-metric-sub) {
    margin: 0;
  }
</style>
