    border-color: var(--color-down);
  }

  .success-text {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.7;
  }

  /* ===== 真实分支 ===== */
  .chip[disabled] {
    opacity: 0.55;
    cursor: not-allowed;
  }

  /* 动态渲染的搜索结果节点无 Astro 作用域属性，样式需 :global 命中 */
  :global(.real-option) {
    display: flex;
    align-items: center;
    width: 100%;
    text-align: left;
    min-height: var(--hit-target);
    padding: 8px 12px;
    border: 1px solid var(--color-border);
