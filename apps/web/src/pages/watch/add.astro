---
/**
 * 添加监控 `/watch/add`（PRD 2.6，5 步表单）：
 * 演示分支：选择对象 → 价格口径 → 目标条件 → 通知方式 → 确认；
 *   每步可前进/后退；必填即时校验；未覆盖对象只允许“收藏”（Permission 说明）。
 * 真实分支：城市 → 类型（房源禁用）→ 对象搜索 → 可选分组 → POST /me/watch-items，
 *   按响应 auto_monitoring 提示后跳回列表；口径/目标条件/通知步骤属 03B/05x，不展示。
 */
import AppShell from "../../layouts/AppShell.astro";

const demoEnabled = import.meta.env.PUBLIC_DEMO_DATA === "1";
const demo = demoEnabled ? (await import("../../data/demo")).demoData : null;

const stepTitles = ["对象", "口径", "目标", "通知", "确认"];
const objectTypes = ["区域", "板块", "小区", "房源"];
const metrics = [
  { key: "list-unit", label: "挂牌单价（元/㎡）" },
  { key: "list-total", label: "挂牌总价（万元）" },
  { key: "median", label: "小区中位价（元/㎡）" },
  { key: "deal", label: "成交中位价（需授权）", note: "仅授权数据支持" },
];
const conditions = [
  { key: "target-price", label: "单价 ≤ 目标价" },
  { key: "drop-rate", label: "较上期跌幅 ≥ 阈值" },
  { key: "peer-median", label: "低于可比样本中位价" },
];
const channels = [
  { key: "daily", label: "每日摘要", hint: "每日一封汇总邮件", checked: true },
  { key: "mail", label: "目标价触发邮件", hint: "触发时立即发送", checked: true },
  { key: "inapp", label: "站内事件", hint: "事件中心可查看", checked: true },
  { key: "push", label: "浏览器推送（可拒绝）", hint: "拒绝不影响其它渠道", checked: false },
];
---

<AppShell title="添加监控" activeTab="watch" demo={demoEnabled} backHref="/watch" showNav={false}>
  {
    demo ? (
      <div class="page">
        {/* 步骤指示 */}
        <ol class="steps" aria-label="表单步骤">
          {stepTitles.map((title, index) => (
            <li
              class="step"
              data-step-dot={index + 1}
              aria-current={index === 0 ? "step" : undefined}
            >
              <span class="step-index num">{index + 1}</span>
              <span class="step-title">{title}</span>
            </li>
          ))}
        </ol>

        <form class="stack add-form" data-add-form novalidate>
          {/* 步骤 1：选择对象 */}
          <section class="card form-step" data-step="1" aria-label="第 1 步 选择对象">
            <h2 class="form-title">第 1 步 · 选择监控对象</h2>
            <div class="field">
              <span class="field-label">对象类型（必选）</span>
              <div class="chip-row" role="radiogroup" aria-label="对象类型">
                {objectTypes.map((type) => (
                  <button
                    type="button"
                    class="chip"
                    role="radio"
                    aria-checked="false"
                    data-object-type={type}
                  >
                    {type}
                  </button>
                ))}
              </div>
              <p class="field-error" data-error="object-type">请选择对象类型</p>
            </div>

            <div class="field">
              <span class="field-label">选择对象（演示目录）</span>
              <div class="stack-sm object-options">
                {demo.regions.map((region) => (
                  <label class="object-option">
                    <input type="radio" name="object" value={region.name} data-object />
                    <span>{region.name}（演示）· 区域</span>
                    <span class="badge badge--down">已覆盖</span>
                  </label>
                ))}
                {demo.communities.slice(0, 3).map((community) => (
                  <label class="object-option">
                    <input type="radio" name="object" value={community.name} data-object />
                    <span>{community.name} · 小区</span>
                    <span class="badge badge--down">已覆盖</span>
                  </label>
                ))}
                <label class="object-option object-option--muted">
                  <input type="radio" name="object" value="__request_only__" data-object />
                  <span>真实目录城市（示例：青岛市）· 未覆盖</span>
                  <span class="badge badge--neutral">仅可收藏</span>
                </label>
              </div>
              <p class="field-error" data-error="object">请选择监控对象</p>
              <p class="meta">
                未覆盖对象只能“收藏观察”，不会显示“已开启自动监控”；覆盖申请流程见账户页。
              </p>
            </div>
          </section>

          {/* 步骤 2：价格口径 */}
          <section class="card form-step is-hidden" data-step="2" aria-label="第 2 步 价格口径">
            <h2 class="form-title">第 2 步 · 价格口径（必选其一）</h2>
            <div class="stack-sm" role="radiogroup" aria-label="价格口径">
              {metrics.map((metric) => (
                <label class="object-option">
                  <input type="radio" name="metric" value={metric.key} data-metric />
                  <span>{metric.label}</span>
                  {metric.note && <span class="badge badge--neutral">{metric.note}</span>}
                </label>
              ))}
            </div>
            <p class="field-error" data-error="metric">请选择价格口径</p>
            <p class="meta">口径将随监控与事件一同展示，避免不同口径混比。</p>
          </section>

          {/* 步骤 3：目标条件 */}
          <section class="card form-step is-hidden" data-step="3" aria-label="第 3 步 目标条件">
            <h2 class="form-title">第 3 步 · 目标条件</h2>
            <div class="field">
              <span class="field-label">触发方式（必选）</span>
              <div class="stack-sm" role="radiogroup" aria-label="触发方式">
                {conditions.map((condition, index) => (
                  <label class="object-option">
                    <input
                      type="radio"
                      name="condition"
                      value={condition.key}
                      data-condition
                      checked={index === 0}
                    />
                    <span>{condition.label}</span>
                  </label>
                ))}
              </div>
            </div>
            <div class="field">
              <label class="field-label" for="target-price">目标价（元/㎡，必填）</label>
              <input
                type="number"
                id="target-price"
                class="input"
                min="1"
                inputmode="numeric"
                placeholder="如：20500"
                data-target-price
              />
              <p class="field-error" data-error="target-price">
                请输入大于 0 的目标价
              </p>
            </div>
            <div class="field">
              <label class="field-label" for="drop-rate">跌幅阈值（%，0–100）</label>
              <input
                type="number"
                id="drop-rate"
                class="input"
                min="0"
                max="100"
                inputmode="decimal"
                placeholder="如：5"
                value="5"
                data-drop-rate
              />
              <p class="field-error" data-error="drop-rate">
                跌幅阈值需在 0–100 之间
              </p>
            </div>
          </section>

          {/* 步骤 4：通知方式 */}
          <section class="card form-step is-hidden" data-step="4" aria-label="第 4 步 通知方式">
            <h2 class="form-title">第 4 步 · 通知方式（至少一项）</h2>
            <div class="stack-sm">
              {channels.map((channel) => (
                <label class="object-option">
                  <input
                    type="checkbox"
                    name="channel"
                    value={channel.key}
                    data-channel
                    checked={channel.checked}
                  />
                  <span>
                    {channel.label}
                    <span class="channel-hint">{channel.hint}</span>
                  </span>
                </label>
              ))}
            </div>
            <p class="field-error" data-error="channel">请至少选择一种通知方式</p>
            <p class="meta">
              浏览器推送权限可拒绝且可随时撤销，拒绝仅影响该渠道；站内事件与邮件不受影响。
            </p>
          </section>

          {/* 步骤 5：确认 */}
          <section class="card form-step is-hidden" data-step="5" aria-label="第 5 步 确认">
            <h2 class="form-title">第 5 步 · 确认并保存</h2>
            <dl class="summary" data-summary>
              <div class="summary-item">
                <dt>对象</dt>
                <dd data-summary-object>未选择</dd>
              </div>
              <div class="summary-item">
                <dt>口径</dt>
                <dd data-summary-metric>未选择</dd>
              </div>
              <div class="summary-item">
                <dt>条件</dt>
                <dd data-summary-condition>未设置</dd>
              </div>
              <div class="summary-item">
                <dt>通知</dt>
                <dd data-summary-channels>未选择</dd>
              </div>
            </dl>
            <p class="meta">
              保存前再次复述数据口径与可用性：未覆盖对象不会产生自动监控；演示环境未接入后端，
              配置仅保存在本页会话中。
            </p>
          </section>

          {/* 前进 / 后退 */}
          <div class="btn-row form-nav">
            <button type="button" class="btn btn--secondary" data-prev disabled>
              ← 上一步
            </button>
            <button type="button" class="btn btn--primary" data-next>
              下一步 →
            </button>
            <button type="submit" class="btn btn--primary is-hidden" data-submit>
              保存监控
            </button>
          </div>
        </form>

        {/* 成功态 */}
        <div class="card success is-hidden" data-success role="status">
          <h2 class="form-title">监控配置已生成</h2>
          <p class="success-text">
            演示环境未接入后端：该配置仅保留在当前会话，未对外发送任何请求。
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/watch">查看我的监控</a>
            <button type="button" class="btn btn--secondary" data-restart>
              再添加一个
            </button>
          </div>
        </div>
      </div>
    ) : (
      <div class="page" data-add-real>
        <form class="stack" data-real-form novalidate>
          {/* 步骤 1：城市（GET /public/cities，未覆盖城市仍可选） */}
          <section class="card form-step" aria-label="第 1 步 选择城市">
            <h2 class="form-title">第 1 步 · 选择城市</h2>
            <div class="field">
              <label class="field-label" for="real-city-q">搜索城市</label>
              <input
                type="search"
                id="real-city-q"
                class="input"
                placeholder="输入城市名，如：青岛"
                autocomplete="off"
                data-city-q
              />
              <p class="meta">
                目录内城市均可选择；未覆盖城市也允许收藏，但不会开启自动价格监控。
              </p>
              <div class="stack-sm real-options" data-city-results></div>
              <p class="field-error" data-error="city">请选择城市</p>
              <p class="meta" data-city-selected>当前未选择城市</p>
            </div>
          </section>

          {/* 步骤 2：类型（房源禁用，需数据来源支持） */}
          <section class="card form-step" aria-label="第 2 步 对象类型">
            <h2 class="form-title">第 2 步 · 对象类型</h2>
            <div class="chip-row" role="radiogroup" aria-label="对象类型">
              <button
                type="button"
                class="chip"
                role="radio"
                aria-checked="false"
                data-real-type="region"
              >
                区域（区县）
              </button>
              <button
                type="button"
                class="chip"
                role="radio"
                aria-checked="false"
                data-real-type="community"
              >
                小区
              </button>
              <button
                type="button"
                class="chip"
                role="radio"
                aria-checked="false"
                data-real-type="listing"
                disabled
                aria-disabled="true"
                title="需数据来源支持"
              >
                房源
              </button>
            </div>
            <p class="meta">房源类型需数据来源支持，当前不可选；指标、目标条件与通知偏好将在后续任务提供。</p>
            <p class="field-error" data-error="type">请选择对象类型</p>
          </section>

          {/* 步骤 3：对象搜索（GET /public/regions、GET /public/communities） */}
          <section class="card form-step" aria-label="第 3 步 搜索对象">
            <h2 class="form-title">第 3 步 · 搜索对象</h2>
            <div class="field is-hidden" data-region-field>
              <label class="field-label" for="real-region-q">搜索区县</label>
              <input
                type="search"
                id="real-region-q"
                class="input"
                placeholder="输入区县名"
                autocomplete="off"
                data-region-q
              />
              <div class="stack-sm real-options" data-region-results></div>
            </div>
            <div class="field is-hidden" data-community-field>
              <label class="field-label" for="real-community-region">所属区县（先选择）</label>
              <select class="input" id="real-community-region" data-community-region>
                <option value="">请选择区县</option>
              </select>
              <label class="field-label" for="real-community-q">搜索小区</label>
              <input
                type="search"
                id="real-community-q"
                class="input"
                placeholder="输入小区名"
                autocomplete="off"
                data-community-q
              />
              <div class="stack-sm real-options" data-community-results></div>
            </div>
            <p class="field-error" data-error="object">请选择监控对象</p>
            <p class="meta" data-object-selected>当前未选择对象</p>
          </section>

          {/* 步骤 4：分组（可选，1–50 字符） */}
          <section class="card form-step" aria-label="第 4 步 分组">
            <h2 class="form-title">第 4 步 · 分组（可选）</h2>
            <div class="field">
              <label class="field-label" for="real-group">分组名称（1–50 字符，可留空）</label>
              <input
                type="text"
                id="real-group"
                class="input"
                maxlength="50"
                placeholder="如：自住考察"
                data-group-input
              />
              <p class="field-error" data-error="group">分组名称需为 1–50 个字符</p>
            </div>
            <p class="field-error" data-error="submit"></p>
            <p class="meta">
              保存即加入监控列表；未覆盖对象不会产生自动监控，指标与目标条件随后续任务接入。
            </p>
          </section>

          <div class="btn-row form-nav">
            <button type="submit" class="btn btn--primary btn--block" data-real-submit>
              添加到监控列表
            </button>
          </div>
        </form>

        {/* 成功态：按响应 auto_monitoring 提示，随后跳回列表 */}
        <div class="card success is-hidden" data-real-success role="status">
          <h2 class="form-title">已添加到监控列表</h2>
          <p class="success-text" data-real-success-msg></p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/watch">查看我的监控</a>
          </div>
        </div>
      </div>
    )
  }
</AppShell>

<script>
  // 分步表单：状态、校验、前进后退、确认摘要、提交（全部本地真实交互）
  const form = document.querySelector<HTMLFormElement>("[data-add-form]");
  if (form) {
    let step = 1;

    const state = {
      objectType: "",
      object: "",
      objectLabel: "",
      metric: "",
      metricLabel: "",
      condition: "",
      targetPrice: "",
      dropRate: "5",
      channels: [] as string[],
    };

    const $ = <T extends HTMLElement>(selector: string) =>
      form.querySelector<T>(selector);

    const showError = (key: string, show: boolean) => {
      form
        .querySelector<HTMLElement>(`[data-error="${key}"]`)
        ?.classList.toggle("is-shown", show);
    };

    const validate = (current: number): boolean => {
      let ok = true;

      if (current === 1) {
        if (!state.objectType) {
          showError("object-type", true);
          ok = false;
        } else showError("object-type", false);
        if (!state.object) {
          showError("object", true);
          ok = false;
        } else showError("object", false);
      }

      if (current === 2) {
        if (!state.metric) {
          showError("metric", true);
          ok = false;
        } else showError("metric", false);
      }

      if (current === 3) {
        const price = Number(state.targetPrice);
        const needPrice = state.condition !== "drop-rate";
        if (needPrice && (!state.targetPrice || !(price > 0))) {
          showError("target-price", true);
          ok = false;
        } else showError("target-price", false);

        const rate = Number(state.dropRate);
        if (
          (state.condition === "drop-rate" || state.dropRate !== "") &&
          (!(rate >= 0) || !(rate <= 100))
        ) {
          showError("drop-rate", true);
          ok = false;
        } else showError("drop-rate", false);
      }

      if (current === 4 && state.channels.length === 0) {
        showError("channel", true);
        ok = false;
      } else if (current === 4) {
        showError("channel", false);
      }

      return ok;
    };

    const renderSummary = () => {
      const setText = (selector: string, value: string) => {
        const el = $<HTMLElement>(selector);
        if (el) el.textContent = value;
      };
      setText(
        "[data-summary-object]",
        `${state.objectLabel || "未选择"}${state.object === "__request_only__" ? "（仅可收藏，不产生自动监控）" : ""}`,
      );
      setText("[data-summary-metric]", state.metricLabel || "未选择");
      const conditionLabel =
        state.condition === "target-price"
          ? `单价 ≤ ${state.targetPrice} 元/㎡`
          : state.condition === "drop-rate"
            ? `较上期跌幅 ≥ ${state.dropRate}%`
            : state.condition === "peer-median"
              ? "低于可比样本中位价"
              : "未设置";
      setText("[data-summary-condition]", conditionLabel);
      setText(
        "[data-summary-channels]",
        state.channels.length > 0 ? state.channels.join("、") : "未选择",
      );
    };

    const showStep = (next: number) => {
      step = next;
      form.querySelectorAll<HTMLElement>("[data-step]").forEach((panel) => {
        panel.classList.toggle("is-hidden", Number(panel.dataset.step) !== step);
      });
      document.querySelectorAll<HTMLElement>("[data-step-dot]").forEach((dot) => {
        const active = Number(dot.dataset.stepDot) === step;
        dot.classList.toggle("is-active", active);
        dot.classList.toggle("is-done", Number(dot.dataset.stepDot) < step);
        if (active) dot.setAttribute("aria-current", "step");
        else dot.removeAttribute("aria-current");
      });

      const prev = $<HTMLButtonElement>("[data-prev]");
      const nextBtn = $<HTMLButtonElement>("[data-next]");
      const submit = $<HTMLButtonElement>("[data-submit]");
      if (prev) prev.disabled = step === 1;
      if (nextBtn) nextBtn.classList.toggle("is-hidden", step === 5);
      if (submit) submit.classList.toggle("is-hidden", step !== 5);
      if (step === 5) renderSummary();
    };

    // 类型选择
    form.querySelectorAll<HTMLElement>("[data-object-type]").forEach((chip) => {
      chip.addEventListener("click", () => {
        state.objectType = chip.dataset.objectType ?? "";
        form.querySelectorAll<HTMLElement>("[data-object-type]").forEach((other) => {
          const checked = other === chip;
          other.classList.toggle("is-active", checked);
          other.setAttribute("aria-checked", checked ? "true" : "false");
        });
        showError("object-type", false);
      });
    });

    // 对象 / 口径 / 条件 / 渠道采集
    form.querySelectorAll<HTMLInputElement>("[data-object]").forEach((input) => {
      input.addEventListener("change", () => {
        state.object = input.value;
        state.objectLabel = (input.parentElement?.textContent ?? "")
          .replace(/\s+/g, " ")
          .replace(/已覆盖|仅可收藏/g, "")
          .trim();
        showError("object", false);
      });
    });

    form.querySelectorAll<HTMLInputElement>("[data-metric]").forEach((input) => {
      input.addEventListener("change", () => {
        state.metric = input.value;
        state.metricLabel = (input.parentElement?.textContent ?? "")
          .replace(/\s+/g, " ")
          .replace(/仅授权数据支持/g, "")
          .trim();
        showError("metric", false);
      });
    });

    form.querySelectorAll<HTMLInputElement>("[data-condition]").forEach((input) => {
      input.addEventListener("change", () => {
        state.condition = input.value;
      });
    });

    const priceInput = $<HTMLInputElement>("[data-target-price]");
    priceInput?.addEventListener("input", () => {
      state.targetPrice = priceInput.value;
    });

    const rateInput = $<HTMLInputElement>("[data-drop-rate]");
    rateInput?.addEventListener("input", () => {
      state.dropRate = rateInput.value;
    });

    const syncChannels = () => {
      state.channels = Array.from(
        form.querySelectorAll<HTMLInputElement>("[data-channel]"),
      )
        .filter((input) => input.checked)
        .map((input) => {
          const label = input.parentElement?.querySelector("span")?.childNodes[0];
          return (label?.textContent ?? input.value).trim();
        });
      if (state.channels.length > 0) showError("channel", false);
    };

    form.querySelectorAll<HTMLInputElement>("[data-channel]").forEach((input) => {
      input.addEventListener("change", syncChannels);
    });
    syncChannels();

    // 前进 / 后退 / 提交
    $<HTMLButtonElement>("[data-next]")?.addEventListener("click", () => {
      if (validate(step)) showStep(Math.min(step + 1, 5));
    });
    $<HTMLButtonElement>("[data-prev]")?.addEventListener("click", () => {
      showStep(Math.max(step - 1, 1));
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!validate(1) || !validate(2) || !validate(3) || !validate(4)) {
        // 回退到第一个未通过的步骤
        if (!validate(1)) showStep(1);
        else if (!validate(2)) showStep(2);
        else if (!validate(3)) showStep(3);
        else showStep(4);
        return;
      }
      form.classList.add("is-hidden");
      document.querySelector<HTMLElement>("[data-success]")?.classList.remove("is-hidden");
      window.dispatchEvent(
        new CustomEvent("app:toast", { detail: { message: "监控配置已生成（演示，仅本地保存）" } }),
      );
    });

    $<HTMLButtonElement>("[data-restart]")?.addEventListener("click", () => {
      document.querySelector<HTMLElement>("[data-success]")?.classList.add("is-hidden");
      form.classList.remove("is-hidden");
      showStep(1);
    });

    showStep(1);
  }
</script>

<script>
  // 真实分支：城市 → 类型 → 对象搜索 → 可选分组 → POST /me/watch-items（409 提示重复）。
  // 展示层不含规则/目标条件/通知偏好（属 03B/05x），未覆盖对象不会显示“已开启自动监控”。
  import { ApiError, createWatchItem, searchCities, searchCommunities, searchRegions } from "../../lib/api";
  import type { CityItem, CommunityItem, RegionItem } from "../../lib/api";

  const realForm = document.querySelector<HTMLFormElement>("[data-real-form]");

  if (realForm) {
    const state: {
      city: { code: string; name: string } | null;
      type: "region" | "community" | null;
      region: { id: string; name: string } | null;
      community: { id: string; name: string } | null;
    } = { city: null, type: null, region: null, community: null };

    const toast = (message: string) => {
      window.dispatchEvent(new CustomEvent("app:toast", { detail: { message } }));
    };

    const showError = (key: string, show: boolean, message?: string) => {
      const el = realForm.querySelector<HTMLElement>(`[data-error="${key}"]`);
      if (!el) return;
      if (message) el.textContent = message;
      el.classList.toggle("is-shown", show);
    };

    const setText = (selector: string, value: string) => {
      const el = realForm.querySelector<HTMLElement>(selector);
      if (el) el.textContent = value;
    };

    const clearBox = (box: HTMLElement | null) => box?.replaceChildren();

    /** 渲染可点选的搜索结果列表（动态节点，样式用 :global） */
    const renderOptions = (
      box: HTMLElement | null,
      options: Array<{ value: string; label: string }>,
      activeValue: string,
      onPick: (value: string, label: string) => void,
    ) => {
      if (!box) return;
      box.replaceChildren();
      if (options.length === 0) {
        const empty = document.createElement("p");
        empty.className = "meta";
        empty.textContent = "无匹配结果，请更换关键词";
        box.append(empty);
        return;
      }
      for (const option of options) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "real-option";
        if (option.value === activeValue) button.classList.add("is-active");
        button.dataset.value = option.value;
        button.textContent = option.label;
        button.addEventListener("click", () => onPick(option.value, option.label));
        box.append(button);
      }
    };

    /** 结果列表内切换选中态 */
    const markActive = (box: HTMLElement | null, value: string) => {
      box?.querySelectorAll<HTMLElement>(".real-option").forEach((button) => {
        button.classList.toggle("is-active", button.dataset.value === value);
      });
    };

    /** 搜索失败：401 已由 API 客户端跳登录，其余提示后可继续 */
    const failSearch = (error: unknown, fallback: string) => {
      if (error instanceof ApiError && error.status === 401) return;
      toast(error instanceof ApiError && error.message ? error.message : fallback);
    };

    const cityInput = realForm.querySelector<HTMLInputElement>("[data-city-q]");
    const cityResults = realForm.querySelector<HTMLElement>("[data-city-results]");
    const regionField = realForm.querySelector<HTMLElement>("[data-region-field]");
    const communityField = realForm.querySelector<HTMLElement>("[data-community-field]");
    const regionInput = realForm.querySelector<HTMLInputElement>("[data-region-q]");
    const regionResults = realForm.querySelector<HTMLElement>("[data-region-results]");
    const regionSelect = realForm.querySelector<HTMLSelectElement>("[data-community-region]");
    const communityInput = realForm.querySelector<HTMLInputElement>("[data-community-q]");
    const communityResults = realForm.querySelector<HTMLElement>("[data-community-results]");
    const groupInput = realForm.querySelector<HTMLInputElement>("[data-group-input]");
    const submitBtn = realForm.querySelector<HTMLButtonElement>("[data-real-submit]");

    const resetObject = () => {
      state.region = null;
      state.community = null;
      clearBox(regionResults);
      clearBox(communityResults);
      setText("[data-object-selected]", "当前未选择对象");
    };

    /** 选中城市（未覆盖城市同样可选）；城市变化时清空对象选择 */
    const pickCity = (code: string, name: string) => {
      const changed = state.city?.code !== code;
      state.city = { code, name };
      showError("city", false);
      setText("[data-city-selected]", `当前选择：${name}`);
      markActive(cityResults, code);
      if (changed) {
        resetObject();
        if (state.type === "community") void loadRegionSelect();
      }
    };

    const loadCities = async (q: string) => {
      try {
        const result = await searchCities(q);
        renderOptions(
          cityResults,
          result.items.map((item: CityItem) => ({ value: item.city_code, label: item.name })),
          state.city?.code ?? "",
          pickCity,
        );
      } catch (error) {
        failSearch(error, "城市搜索失败");
      }
    };

    let cityTimer = 0;
    cityInput?.addEventListener("input", () => {
      window.clearTimeout(cityTimer);
      const q = cityInput.value.trim();
      cityTimer = window.setTimeout(() => void loadCities(q), 300);
    });

    /** 小区流程：先按城市加载区县下拉（GET /public/regions?city_code=） */
    const loadRegionSelect = async () => {
      if (!regionSelect) return;
      if (!state.city) {
        showError("city", true);
        toast("请先选择城市");
        return;
      }
      try {
        const result = await searchRegions(state.city.code, "");
        const placeholder = document.createElement("option");
        placeholder.value = "";
        placeholder.textContent = "请选择区县";
        const options = result.items.map((item: RegionItem) => {
          const option = document.createElement("option");
          option.value = item.region_id;
          option.textContent = item.name;
          return option;
        });
        regionSelect.replaceChildren(placeholder, ...options);
        regionSelect.value = state.region?.id ?? "";
      } catch (error) {
        failSearch(error, "区县列表加载失败");
      }
    };

    /** 类型切换：区域走 regions 搜索；小区需先选区县；房源禁用（需数据来源支持） */
    realForm.querySelectorAll<HTMLButtonElement>("[data-real-type]").forEach((chip) => {
      chip.addEventListener("click", () => {
        if (chip.disabled) return;
        const type = chip.dataset.realType;
        if (type !== "region" && type !== "community") return;
        state.type = type;
        realForm.querySelectorAll<HTMLButtonElement>("[data-real-type]").forEach((other) => {
          const active = other === chip;
          other.classList.toggle("is-active", active);
          other.setAttribute("aria-checked", active ? "true" : "false");
        });
        showError("type", false);
        regionField?.classList.toggle("is-hidden", type !== "region");
        communityField?.classList.toggle("is-hidden", type !== "community");
        resetObject();
        if (type === "community") void loadRegionSelect();
      });
    });

    regionSelect?.addEventListener("change", () => {
      const name = regionSelect.selectedOptions[0]?.textContent ?? "";
      state.region = regionSelect.value ? { id: regionSelect.value, name } : null;
      state.community = null;
      clearBox(communityResults);
      showError("object", false);
      setText("[data-object-selected]", "当前未选择对象");
    });

    /** 区域对象搜索（GET /public/regions?city_code=&q=） */
    let regionTimer = 0;
    const loadRegions = async (q: string) => {
      if (!state.city) {
        showError("city", true);
        toast("请先选择城市");
        return;
      }
      try {
        const result = await searchRegions(state.city.code, q);
        renderOptions(
          regionResults,
          result.items.map((item: RegionItem) => ({ value: item.region_id, label: item.name })),
          state.region?.id ?? "",
          (value, label) => {
            state.region = { id: value, name: label };
            showError("object", false);
            markActive(regionResults, value);
            setText("[data-object-selected]", `当前选择：${label}`);
          },
        );
      } catch (error) {
        failSearch(error, "区县搜索失败");
      }
    };
    regionInput?.addEventListener("input", () => {
      window.clearTimeout(regionTimer);
      const q = regionInput.value.trim();
      regionTimer = window.setTimeout(() => void loadRegions(q), 300);
    });

    /** 小区对象搜索（GET /public/communities?region_id=&q=） */
    let communityTimer = 0;
    const loadCommunities = async (q: string) => {
      if (!state.region) {
        toast("请先选择所属区县");
        return;
      }
      try {
        const result = await searchCommunities(state.region.id, q);
        renderOptions(
          communityResults,
          result.items.map((item: CommunityItem) => ({
            value: item.community_id,
            label: item.name,
          })),
          state.community?.id ?? "",
          (value, label) => {
            state.community = { id: value, name: label };
            showError("object", false);
            markActive(communityResults, value);
            setText("[data-object-selected]", `当前选择：${label}`);
          },
        );
      } catch (error) {
        failSearch(error, "小区搜索失败");
      }
    };
    communityInput?.addEventListener("input", () => {
      window.clearTimeout(communityTimer);
      const q = communityInput.value.trim();
      communityTimer = window.setTimeout(() => void loadCommunities(q), 300);
    });

    /** 提交：POST /me/watch-items → 按 auto_monitoring 提示 → 跳回列表 */
    let submitting = false;
    realForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submitting) return;

      if (!state.city) {
        showError("city", true);
        return;
      }
      if (!state.type) {
        showError("type", true);
        return;
      }
      let objectId = "";
      let objectName = "";
      if (state.type === "region") {
        if (!state.region) {
          showError("object", true);
          return;
        }
        objectId = state.region.id;
        objectName = state.region.name;
      } else {
        if (!state.region) {
          toast("请先选择所属区县");
          return;
        }
        if (!state.community) {
          showError("object", true);
          return;
        }
        objectId = state.community.id;
        objectName = state.community.name;
      }
      showError("submit", false);

      const group = groupInput?.value.trim() ?? "";
      submitting = true;
      if (submitBtn) submitBtn.disabled = true;
      try {
        const result = await createWatchItem({
          object_type: state.type,
          object_id: objectId,
          display_name_snapshot: objectName,
          ...(group ? { group_name: group } : {}),
        });
        const monitored = result.item.auto_monitoring === true;
        const message = monitored ? "已开启自动价格监控" : "已收藏，未开启自动价格监控";
        realForm.classList.add("is-hidden");
        const successPanel = document.querySelector<HTMLElement>("[data-real-success]");
        const successMsg = successPanel?.querySelector<HTMLElement>("[data-real-success-msg]");
        if (successMsg) successMsg.textContent = `${objectName}：${message}`;
        successPanel?.classList.remove("is-hidden");
        toast(message);
        window.setTimeout(() => {
          window.location.href = "/watch";
        }, 1800);
        return;
      } catch (error) {
        const status = error instanceof ApiError ? error.status : 0;
        if (status === 409) {
          showError("submit", true, "该对象已在监控列表中");
        } else if (status === 404) {
          showError("submit", true, "对象不存在或已下架，请重新搜索");
        } else if (status === 401) {
          // API 客户端已统一跳转登录
        } else if (error instanceof ApiError && error.message) {
          showError("submit", true, error.message);
        } else {
          showError("submit", true, "保存失败，请稍后重试");
        }
      } finally {
        submitting = false;
        if (submitBtn) submitBtn.disabled = false;
      }
    });

    // 初始加载城市目录（空关键词 = 默认列表）
    void loadCities("");
  }
</script>

