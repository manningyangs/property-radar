---
/**
 * 管理员总览 `/admin`（PRD 8.1 / 8.2 / 任务行 1368–1374 / 设计稿 §2.8 与 §四）：
 * 左侧深色导航（PRD 10 项，未建路由者标注“暂未开放”）→ 顶部状态条（城市选择 / 城市覆盖状态 /
 * 系统健康状态，任务行 UI 要求）→ 4 张指标卡（任务成功率 / 数据更新时间 / 已覆盖小区数 /
 * 来源异常数，数据源 GET /admin/overview ops 块）→ 快捷入口 + 来源许可分布。
 * 默认构建（非 demo）为真实 API 页：AdminMfaGate 门禁 + lib/admin-gate.ts 状态机（TASK-06D）。
 * PUBLIC_DEMO_DATA=1 时保留 M1 演示分支（对象目录表 + 抽屉 + 会话审计）。
 */
import AppShell from "../layouts/AppShell.astro";
import AdminDataTable from "../components/AdminDataTable.astro";
import ConfirmDialog from "../components/ConfirmDialog.astro";
import AdminSidebar from "../components/AdminSidebar.astro";
import AdminMfaGate from "../components/AdminMfaGate.astro";

const demoEnabled = import.meta.env.PUBLIC_DEMO_DATA === "1";
const demo = demoEnabled ? (await import("../data/demo")).demoData : null;

/** PRD 8.1 后台导航 10 项；总览/数据源中心（06C）/采集任务/数据质量（06D）已建路由 */
const navItems: { label: string; href?: string; active?: boolean }[] = [
  { label: "数据运营总览", active: true },
  { label: "用户管理" },
  { label: "行政区与小区目录" },
  { label: "数据源中心", href: "/admin/sources" },
  { label: "数据覆盖地图" },
  { label: "采集任务与日志", href: "/admin/jobs" },
  { label: "数据质量中心", href: "/admin/quality" },
  { label: "事件与通知投递" },
  { label: "管理员角色与审计" },
  { label: "系统参数与费用用量" },
];

const columns = [
  { key: "object", label: "对象" },
  { key: "type", label: "类型" },
  { key: "status", label: "状态" },
  { key: "sample", label: "样本", numeric: true },
  { key: "updated", label: "更新时间", numeric: true },
  { key: "source", label: "来源" },
];
const statusIndex = columns.findIndex((column) => column.key === "status");

const rows: Record<string, string | number>[] = demo ? demo.admin.rows : [];
const metrics = demo ? demo.admin.metrics : [];
---

<AppShell title="管理后台" demo={demoEnabled} showNav={false} variant="admin">
  {/* 左侧深色导航必须是 AppShell 的直接子节点并带 slot 属性：
      Astro 仅静态收集直接子级上的 slot，嵌入三元表达式/Fragment 会被静默丢弃。
      demo 分支渲染演示导航；真实分支复用 AdminSidebar（bare 模式，06D） */}
  <div slot="sidebar" class="side">
    {
      demo ? (
        <>
          <div class="side-brand">
            <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true">
              <rect width="32" height="32" rx="7" fill="#ffffff" fill-opacity="0.12" />
              <path
                d="M6 22 L13 14 L18 18 L26 9"
                stroke="#7FB0FF"
                stroke-width="3"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span>房价雷达 · 管理</span>
          </div>
          <nav class="side-nav" aria-label="后台导航">
            {navItems.map((item) =>
              item.active ? (
                <a class="side-link is-active" href="/admin" aria-current="page">
                  {item.label}
                </a>
              ) : item.href ? (
                <a class="side-link" href={item.href}>{item.label}</a>
              ) : (
                <button type="button" class="side-link" data-soon={item.label}>
                  <span class="side-link-label">{item.label}</span>
                  <span class="badge badge--neutral">暂未开放</span>
                </button>
              ),
            )}
          </nav>
          <p class="side-foot">演示构建 · 演示数据</p>
        </>
      ) : (
        <AdminSidebar bare active="数据运营总览" />
      )
    }
  </div>

  {
    demo ? (
      <div class="page admin-page">
          {/* 顶部状态条 */}
          <div class="statusbar" role="status">
            <button
              type="button"
              class="chip is-active"
              data-scope
              data-scope-options="全部,演示市"
              aria-pressed="true"
            >
              城市范围：<span data-scope-label>全部</span>
            </button>
            <span class="badge badge--primary">● 采集运行中</span>
            <span class="badge badge--warning">2 个数据源延迟</span>
            <span class="meta">今日入库 <span class="num">1,204</span> 条</span>
            <span class="badge badge--neutral">管理员 admin@demo</span>
            <button type="button" class="btn btn--sm btn--secondary" data-soon="导出审计记录">
              导出审计记录
              <span class="badge badge--neutral">暂未开放</span>
            </button>
          </div>

          {/* 指标卡（4 张，可换行不横向溢出） */}
          <div class="grid-2 metric-grid">
            {metrics.map((metric) => (
              <div class="metric-card">
                <span class="metric-label">{metric.label}</span>
                <span class="metric-value num">{metric.value}</span>
                <span class="meta">{metric.hint}</span>
              </div>
            ))}
          </div>

          {/* 对象目录数据表 */}
          <section class="admin-section" aria-labelledby="adm-table-title">
            <div class="section-head">
              <h2 class="section-title" id="adm-table-title">对象目录</h2>
              <span class="meta">行点击 / 详情 → 右侧抽屉处理</span>
            </div>
            <AdminDataTable
              columns={columns}
              rows={rows}
              filters={["正常", "待审核", "已停用"]}
              filterKey="status"
              searchPlaceholder="搜索对象、来源…"
              emptyText="没有匹配的对象"
            />
          </section>

          {/* 会话审计日志 */}
          <section class="card audit-card" aria-labelledby="adm-audit-title">
            <div class="acc-head">
              <h2 class="section-title" id="adm-audit-title">本次会话审计日志</h2>
              <span class="meta">批准 / 停用 均需二次确认并记录</span>
            </div>
            <ul class="audit-list" data-audit-list>
              <li class="audit-empty meta" data-audit-empty>
                暂无操作记录。完整审计日志子模块将在后续任务提供（当前标注“暂未开放”）。
              </li>
            </ul>
          </section>

          {/* 右侧详情抽屉 */}
          <aside
            class="drawer is-hidden"
            data-drawer
            data-status-index={statusIndex}
            role="dialog"
            aria-modal="false"
            aria-label="对象详情"
          >
            <div class="drawer-head">
              <h2 class="drawer-title">对象详情</h2>
              <button type="button" class="icon-btn" data-drawer-close aria-label="关闭详情抽屉">
                <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                  <path
                    d="M5 5 L15 15 M15 5 L5 15"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                </svg>
              </button>
            </div>
            <dl class="drawer-fields">
              <dt>ID</dt>
              <dd class="num" data-field="id">—</dd>
              <dt>对象</dt>
              <dd data-field="object">—</dd>
              <dt>类型</dt>
              <dd data-field="type">—</dd>
              <dt>状态</dt>
              <dd data-field="status">—</dd>
              <dt>样本</dt>
              <dd class="num" data-field="sample">—</dd>
              <dt>更新时间</dt>
              <dd class="num" data-field="updated">—</dd>
              <dt>来源</dt>
              <dd data-field="source">—</dd>
              <dt>归属</dt>
              <dd data-field="owner">—</dd>
            </dl>
            <div class="btn-row drawer-actions">
              <button type="button" class="btn btn--primary btn--sm" data-action="approve" data-dialog-open="admin-confirm">
                批准
              </button>
              <button type="button" class="btn btn--danger btn--sm" data-action="disable" data-dialog-open="admin-confirm">
                停用
              </button>
            </div>
            <p class="meta">操作立即生效并写入会话审计日志；未审批对象不能进入自动采集。</p>
          </aside>

          <ConfirmDialog
            id="admin-confirm"
            title="确认操作"
            message="该操作将立即改变对象状态并记入审计日志。"
            confirmText="确认执行"
            danger
          />
        </div>
    ) : (
      <div class="page admin-page">
        <AdminMfaGate />

        <div data-main hidden>
          {/* 顶部状态条：城市选择 / 城市覆盖状态 / 系统健康状态（任务行 UI 要求） */}
          <div class="statusbar" role="status">
            <label class="field-label" for="adm-city">城市选择</label>
            <select id="adm-city" class="input input--sm" data-city>
              <option value="">全部城市</option>
            </select>
            <span class="badge badge--neutral" data-city-coverage>覆盖状态 —</span>
            <span class="badge badge--primary" data-sys-health>● 系统健康 —</span>
          </div>

          {/* 首屏四指标卡（任务行 1372；数据源 overview.ops） */}
          <div class="grid-2 metric-grid">
            <div class="metric-card">
              <span class="metric-label">任务成功率（近 7 日）</span>
              <span class="metric-value num" data-m-rate>—</span>
              <span class="meta" data-m-rate-hint></span>
            </div>
            <div class="metric-card">
              <span class="metric-label">数据更新时间</span>
              <span class="metric-value num" data-m-update>—</span>
              <span class="meta">今日有效快照 <b class="num" data-m-snap>—</b> 条</span>
            </div>
            <div class="metric-card">
              <span class="metric-label">已覆盖小区数</span>
              <span class="metric-value num" data-m-comm>—</span>
              <span class="meta">有效快照去重</span>
            </div>
            <div class="metric-card">
              <span class="metric-label">来源异常数</span>
              <span class="metric-value num" data-m-issue>—</span>
              <span class="meta">健康 ≠ ok ∪ 近 7 日失败任务来源（去重）</span>
            </div>
          </div>

          {/* 快捷入口（06C/06D 已建路由） */}
          <section class="card quick-card" aria-label="快捷入口">
            <div class="btn-row">
              <a class="btn btn--primary btn--sm" href="/admin/sources">数据源中心</a>
              <a class="btn btn--secondary btn--sm" href="/admin/jobs">采集任务与日志</a>
              <a class="btn btn--secondary btn--sm" href="/admin/quality">数据质量中心</a>
            </div>
          </section>

          {/* 来源许可分布（overview.sources.by_status） */}
          <section class="card status-card" aria-labelledby="adm-src-title">
            <h2 class="section-title" id="adm-src-title">来源许可分布</h2>
            <div class="chip-row" data-src-status>
              <span class="meta">加载中…</span>
            </div>
          </section>
        </div>
      </div>
    )
  }
</AppShell>

<script>
  // 数据表行点击（app:admin-row）→ 抽屉；批准/停用二次确认 → 状态更新 + 会话审计日志
  interface DrawerData {
    id: string;
    status: string;
  }

  let pending: DrawerData | null = null;
  /** 抽屉内最近一次点击的待执行操作（approve / disable） */
  let lastAction: "approve" | "disable" | null = null;

  const statusIndex = Number(
    document.querySelector<HTMLElement>("[data-drawer]")?.dataset.statusIndex ?? "0",
  );

  const statusBadgeClass = (status: string) =>
    status === "正常"
      ? "badge badge--primary"
      : status === "待审核"
        ? "badge badge--warning"
        : "badge badge--neutral";

  const toast = (message: string) => {
    window.dispatchEvent(new CustomEvent("app:toast", { detail: { message } }));
  };

  // 状态列初始渲染为语义徽标
  document.querySelectorAll<HTMLElement>("tr[data-admin-row]").forEach((row) => {
    const cell = row.querySelectorAll<HTMLElement>("td")[statusIndex];
    const status = row.dataset.rowFilter ?? "";
    if (cell && status) {
      const span = document.createElement("span");
      span.className = statusBadgeClass(status);
      span.textContent = status;
      cell.replaceChildren(span);
    }
  });

  const setDrawerField = (key: string, value: string) => {
    const el = document.querySelector<HTMLElement>(`[data-field="${key}"]`);
    if (el) el.textContent = value;
  };

  const syncActions = (status: string) => {
    const approve = document.querySelector<HTMLButtonElement>('[data-action="approve"]');
    const disable = document.querySelector<HTMLButtonElement>('[data-action="disable"]');
    if (approve) {
      approve.disabled = status === "正常";
      approve.textContent = status === "已停用" ? "恢复启用" : "批准";
    }
    if (disable) {
      disable.disabled = status === "已停用";
      disable.textContent = status === "已停用" ? "已停用" : "停用";
    }
  };

  window.addEventListener("app:admin-row", (event) => {
    const detail = (event as CustomEvent<{ id: string; filter: string; text: string }>).detail;
    const row = document.querySelector<HTMLElement>(
      `tr[data-admin-row][data-row-id="${detail.id}"]`,
    );
    if (!row) return;
    const cells = row.querySelectorAll<HTMLElement>("td");
    const value = (index: number) => cells[index]?.textContent?.trim() ?? "—";

    pending = { id: detail.id, status: detail.filter };
    setDrawerField("id", detail.id);
    setDrawerField("object", value(0));
    setDrawerField("type", value(1));
    setDrawerField("status", detail.filter);
    setDrawerField("sample", value(3));
    setDrawerField("updated", value(4));
    setDrawerField("source", value(5));
    setDrawerField("owner", detail.text.includes("目录申请") ? "目录申请" : "系统/管理员");
    syncActions(detail.filter);
    document.querySelector<HTMLElement>("[data-drawer]")?.classList.remove("is-hidden");
  });

  document
    .querySelector<HTMLButtonElement>("[data-drawer-close]")
    ?.addEventListener("click", () => {
      document.querySelector<HTMLElement>("[data-drawer]")?.classList.add("is-hidden");
    });

  // 二次确认后执行：更新行状态 + 抽屉 + 审计日志
  window.addEventListener("app:confirm", (event) => {
    const detail = (event as CustomEvent<{ id: string }>).detail;
    if (detail.id !== "admin-confirm" || !pending) return;

    const action = lastAction ?? "approve";
    const row = document.querySelector<HTMLElement>(
      `tr[data-admin-row][data-row-id="${pending.id}"]`,
    );
    const cells = row?.querySelectorAll<HTMLElement>("td");
    const objectName = cells?.[0]?.textContent?.trim() ?? pending.id;
    const newStatus = action === "disable" ? "已停用" : "正常";

    if (row && cells) {
      const cell = cells[statusIndex];
      if (cell) {
        const span = document.createElement("span");
        span.className = statusBadgeClass(newStatus);
        span.textContent = newStatus;
        cell.replaceChildren(span);
      }
      row.setAttribute("data-row-filter", newStatus);
    }

    pending.status = newStatus;
    setDrawerField("status", newStatus);
    syncActions(newStatus);
    appendAudit(
      action === "disable"
        ? `停用 · ${objectName}（${pending.id}）`
        : `批准/恢复 · ${objectName}（${pending.id}）`,
    );
    toast(action === "disable" ? `已停用：${objectName}` : `已批准并恢复：${objectName}`);
    pending = null;
  });

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const actionBtn = target.closest<HTMLElement>("[data-action]");
    if (actionBtn) {
      lastAction = actionBtn.dataset.action === "disable" ? "disable" : "approve";
      return;
    }
    const soon = target.closest<HTMLElement>("[data-soon]");
    if (soon) {
      toast(`「${soon.dataset.soon ?? ""}」暂未开放，将在后续任务实现`);
      return;
    }
    const scope = target.closest<HTMLElement>("[data-scope]");
    if (scope) {
      const options = (scope.dataset.scopeOptions ?? "").split(",").filter(Boolean);
      const label = scope.querySelector<HTMLElement>("[data-scope-label]");
      const current = label?.textContent ?? "";
      const index = options.indexOf(current);
      const next = options.length > 0 ? options[(index + 1) % options.length] : null;
      if (label && next) {
        label.textContent = next;
        toast(`城市范围已切换为「${next}」（演示目录数据仅覆盖演示对象）`);
      }
    }
  });

  function appendAudit(text: string) {
    const list = document.querySelector<HTMLElement>("[data-audit-list]");
    if (!list) return;
    list.querySelector<HTMLElement>("[data-audit-empty]")?.remove();
    const item = document.createElement("li");
    item.className = "audit-item";
    const time = document.createElement("span");
    time.className = "audit-time num";
    time.textContent = new Date().toLocaleTimeString("zh-CN", { hour12: false });
    const body = document.createElement("span");
    body.className = "audit-body";
    body.textContent = `${text} · 操作人 管理员 admin@demo`;
    item.append(time, body);
    list.prepend(item);
  }
</script>

<script>
  // TASK-06D：真实总览（非 demo 构建）。initAdminGate 门禁 → GET /admin/overview + 城市目录。
  // 四指标卡=overview.ops（成功率/更新时间/覆盖小区/来源异常）；
  // 顶部状态条=城市选择/城市覆盖状态/系统健康状态（任务行 1372）。
  import {
    adminOverview,
    ApiError,
    searchCities,
    type AdminOverviewResult,
    type CityItem,
  } from "../lib/api";
  import { initAdminGate } from "../lib/admin-gate";

  const $ = <T extends Element>(sel: string): T | null =>
    document.querySelector<T>(sel);

  const setText = (sel: string, text: string): void => {
    const el = $<HTMLElement>(sel);
    if (el) el.textContent = text;
  };

  const toast = (message: string): void => {
    window.dispatchEvent(new CustomEvent("app:toast", { detail: { message } }));
  };

  let cities: CityItem[] = [];

  const COVERAGE_TEXT: Record<string, string> = {
    full: "全覆盖",
    partial: "部分覆盖",
    none: "未覆盖",
  };

  const SRC_STATUS_TEXT: Record<string, string> = {
    approved_open: "公开已批准",
    approved_licensed: "授权已批准",
    discovered: "已发现",
    pending_review: "待审核",
    manual_only: "仅手动",
    suspended: "已停用",
    blocked: "已封禁",
  };

  function renderOps(b: AdminOverviewResult): void {
    const ops = b.ops;
    setText(
      "[data-m-rate]",
      ops.success_rate_7d === null
        ? "无已完成任务"
        : `${(ops.success_rate_7d * 100).toFixed(1)}%`,
    );
    setText(
      "[data-m-rate-hint]",
      `近 7 日成功 ${ops.jobs_7d.succeeded} / 失败 ${ops.jobs_7d.failed} / 运行中 ${ops.jobs_7d.running}`,
    );
    setText("[data-m-update]", ops.last_update_at ?? "尚无有效数据");
    setText("[data-m-snap]", String(b.snapshots.today_valid));
    setText("[data-m-comm]", String(ops.communities_covered));
    setText("[data-m-issue]", String(ops.source_issue_count));

    const health = $<HTMLElement>("[data-sys-health]");
    if (health) {
      if (ops.source_issue_count === 0) {
        health.className = "badge badge--primary";
        health.textContent = "● 系统健康";
      } else {
        health.className = "badge badge--danger";
        health.textContent = `▲ ${ops.source_issue_count} 个来源异常`;
      }
    }

    const box = $<HTMLElement>("[data-src-status]");
    if (box) {
      const entries = Object.entries(b.sources.by_status);
      box.innerHTML =
        entries.length === 0
          ? `<span class="meta">暂无登记来源</span>`
          : entries
              .map(
                ([status, n]) =>
                  `<span class="badge badge--neutral">${escHtml(SRC_STATUS_TEXT[status] ?? status)} × ${String(n)}</span>`,
              )
              .join("");
    }
  }

  const escHtml = (text: string): string =>
    text
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");

  function renderCityOptions(): void {
    const sel = $<HTMLSelectElement>("[data-city]");
    if (!sel) return;
    sel.innerHTML = `<option value="">全部城市</option>${cities
      .map((c) => `<option value="${escHtml(c.city_code)}">${escHtml(c.name)}</option>`)
      .join("")}`;
  }

  function renderCoverage(): void {
    const code = $<HTMLSelectElement>("[data-city]")?.value ?? "";
    const badge = $<HTMLElement>("[data-city-coverage]");
    if (!badge) return;
    const covered = cities.filter(
      (c) => c.coverage_level === "full" || c.coverage_level === "partial",
    ).length;
    if (!code) {
      badge.textContent = `城市覆盖：${String(covered)}/${String(cities.length)} 城`;
      return;
    }
    const city = cities.find((c) => c.city_code === code);
    badge.textContent = `${city?.name ?? code}：${COVERAGE_TEXT[city?.coverage_level ?? ""] ?? "未覆盖"}`;
  }

  async function loadAll(): Promise<void> {
    try {
      const [overview, cityRes] = await Promise.all([
        adminOverview(),
        searchCities(),
      ]);
      cities = cityRes.items;
      renderOps(overview);
      renderCityOptions();
      renderCoverage();
    } catch (err) {
      if (err instanceof ApiError && err.status === 401) return;
      toast(`加载总览失败：${err instanceof Error ? err.message : String(err)}`);
    }
  }

  $<HTMLSelectElement>("[data-city]")?.addEventListener("change", () => {
    renderCoverage();
  });

  initAdminGate(() => loadAll());
</script>

<style>
  .admin-page {
