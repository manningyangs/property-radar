---
/**
 * 首页 `/`（PRD 2.3）：5 秒内回答“今天数据是否更新、有没有与我有关的价格事件”。
 * 模块顺序：搜索 → 今日数据状态 → 数据延迟提示 → 今日与我有关 → 重点监控 →
 *          区域市场变化（口径分列）→ 最近更新小区 → 数据说明入口。
 * 生产构建（无 PUBLIC_DEMO_DATA）：全部行情模块降级为 EmptyState，零行情数字。
 */
import AppShell from "../layouts/AppShell.astro";
import GlobalSearch from "../components/GlobalSearch.astro";
import EmptyState from "../components/EmptyState.astro";
import StaleDataNotice from "../components/StaleDataNotice.astro";
import DataFreshnessBadge from "../components/DataFreshnessBadge.astro";
import PriceMetricCard from "../components/PriceMetricCard.astro";
import EventTimelineItem from "../components/EventTimelineItem.astro";
import WatchItemCard from "../components/WatchItemCard.astro";
import CommunityCard from "../components/CommunityCard.astro";
import TrendChart from "../components/TrendChart.astro";
import SourceAttribution from "../components/SourceAttribution.astro";

const demoEnabled = import.meta.env.PUBLIC_DEMO_DATA === "1";
const demo = demoEnabled ? (await import("../data/demo")).demoData : null;

const suggestions = demo
  ? [...demo.communities.map((item) => item.name), ...demo.regions.map((item) => item.name)]
  : [];
---

<AppShell title="首页" activeTab="home" demo={demoEnabled} showCity>
  {
    demo ? (
      <div class="page">
        <GlobalSearch suggestions={suggestions} />

        {/* 今日数据状态 */}
        <section class="card status-card" aria-label="今日数据状态">
          <div class="status-head">
            <span class="section-title">今日数据状态</span>
            <DataFreshnessBadge status="fresh" date={demo.freshness.lastSuccess} compact />
          </div>
          <div class="grid-2 status-grid">
            <div class="status-item">
              <span class="status-num num">{demo.freshness.communities}</span>
              <span class="status-label">覆盖小区（演示市）</span>
            </div>
            <div class="status-item">
              <span class="status-num num status-num--warn">
                {demo.freshness.delayedSources}
              </span>
              <span class="status-label">延迟数据源（需留意）</span>
            </div>
          </div>
          <p class="meta">
            最后成功更新 <span class="num">{demo.freshness.lastSuccess}</span>
            · 延迟源数量单独提示，不用“正常”颜色掩盖延迟。
          </p>
        </section>

        <StaleDataNotice
          source={demo.stale.source}
          lastValid={demo.stale.lastValid}
          days={demo.stale.days}
        />

        {/* 今日与我有关 */}
        <section aria-label="今日与我有关的事件">
          <div class="section-head">
            <h2 class="section-title">今日与我有关</h2>
            <a class="section-more" href="/events">
              全部事件 ›
            </a>
          </div>
          <div class="stack-sm">
            {demo.events.slice(0, 2).map((event) => (
              <EventTimelineItem {...event} />
            ))}
          </div>
        </section>

        {/* 我的重点监控 */}
        <section aria-label="我的重点监控">
          <div class="section-head">
            <h2 class="section-title">我的重点监控</h2>
            <a class="section-more" href="/watch">
              管理 ›
            </a>
          </div>
          <div class="stack-sm">
            {demo.watchItems.slice(0, 1).map((item) => (
              <WatchItemCard {...item} dialogId="home-watch-dialog" showActions={false} />
            ))}
          </div>
          <div class="btn-row" style="margin-top: 12px">
            <a class="btn btn--primary btn--block" href="/watch/add">
              + 快速添加监控
            </a>
          </div>
        </section>

        {/* 区域市场变化：挂牌参考与实际成交分列 */}
        <section aria-label="区域市场变化">
          <div class="section-head">
            <h2 class="section-title">区域市场变化</h2>
            <a class="section-more" href="/regions">
              区域 ›
            </a>
          </div>
          <div class="stack-sm">
            <div class="card">
              <TrendChart
                points={demo.cityMarket.series["30"] ?? []}
                metric="全市挂牌中位价趋势（挂牌参考 · 近 30 日）"
                source="演示数据源汇总"
                statDate="2026-11-10"
                trend="down"
              />
            </div>
            <div class="grid-2">
              <PriceMetricCard
                metric="挂牌参考 · 中位价"
                value={demo.cityMarket.listMedian.toLocaleString("zh-CN")}
                direction="down"
                percent={demo.cityMarket.listChange}
                statDate="2026-11-10"
                sample={demo.cityMarket.listSample}
                status={{ text: "数据正常", tone: "ok" }}
              />
              <PriceMetricCard
                metric="实际成交 · 中位价"
                value={demo.cityMarket.dealMedian.toLocaleString("zh-CN")}
                direction="down"
                percent={demo.cityMarket.dealChange}
                statDate="2026-11-10"
                sample={demo.cityMarket.dealSample}
                status={{ text: "数据正常", tone: "ok" }}
                footer="成交与挂牌口径分别呈现，不混用。"
              />
            </div>
          </div>
        </section>

        {/* 最近更新的小区 */}
        <section aria-label="最近更新的小区">
          <div class="section-head">
            <h2 class="section-title">最近更新的小区</h2>
            <a class="section-more" href="/communities">
              搜索 ›
            </a>
          </div>
          <div class="stack-sm">
            {demo.communities.slice(0, 3).map((item) => (
              <CommunityCard
                id={item.id}
                name={item.name}
                regionName={item.regionName}
                plate={item.plate}
                median={item.median}
                change30={item.change30}
                direction={item.direction}
                sample={item.sample}
                statDate={item.statDate}
                source={item.source}
                status={item.status}
              />
            ))}
          </div>
        </section>

        {/* 数据说明入口 */}
        <section aria-label="数据说明">
          <div class="section-head">
            <h2 class="section-title">数据说明</h2>
            <a class="section-more" href="/account">
              账户与隐私 ›
            </a>
          </div>
          <SourceAttribution
            metric="挂牌参考 / 实际成交（分口径）"
            source="演示数据源A / 演示数据源B（演示）"
            statDate="2026-11-10"
            collectedAt="2026-11-10 06:10"
            quality="B"
            note="示例对象均为虚构（演示市）；生产环境不会展示任何演示行情。样本不足时按质量分层降级展示。"
          />
        </section>
      </div>
    ) : (
      <div class="page">
        <GlobalSearch />

        {/* 今日与我有关（05A 真实事件：登录态拉取，Asia/Shanghai 当日前 3 条） */}
        <section aria-label="今日与我有关的事件" class="today-events" data-today-events>
          <div class="section-head">
            <h2 class="section-title">今日与我有关</h2>
            <a class="section-more" href="/events">
              全部事件 ›
            </a>
          </div>
          <p class="meta is-hidden" data-today-loading>正在加载今日事件…</p>
          <div class="stack-sm is-hidden" data-today-list></div>
          <div class="is-hidden" data-today-empty>
            <EmptyState
              title="今天暂无新事件"
              description="监控对象的价格与数据状态今天没有变化；出现新事件时会第一时间显示在这里。"
            />
          </div>
          <div class="is-hidden" data-today-login>
            <EmptyState
              title="登录后查看今日事件"
              description="事件由你的监控对象与规则触发；登录后可查看与你有关的今日事件与未读提醒。"
              actionText="登录"
              actionHref="/login"
            />
          </div>
          <div class="is-hidden" data-today-error>
            <EmptyState
              title="今日事件加载失败"
              description="无法连接服务获取事件数据，请稍后重试。"
            >
              <button type="button" class="btn btn--secondary" data-today-retry>
                重新加载
              </button>
            </EmptyState>
          </div>
        </section>

        <EmptyState
          title="暂未覆盖，可提交覆盖申请"
          description="当前构建未接入任何房价数据源，因此不展示任何价格数字。可先浏览标准城市目录、提交覆盖申请，或登录后收藏关注对象。"
          actionText="登录后提交覆盖申请"
          actionHref="/login"
        />
        <p class="meta prod-note">
          说明：城市选择器提供 337 个目录城市（仅元数据，全部“可申请”状态），未覆盖城市不会填充假数据。
        </p>
      </div>
    )
  }
</AppShell>

<script>
  import { ApiError, listEvents } from "../lib/api";
  import type { AlertEvent } from "../lib/api";
  import { eventLabel, eventShanghaiDate, formatEventClock, todayShanghaiDate } from "../lib/events";

  const root = document.querySelector<HTMLElement>("[data-today-events]");

  if (root) {
    const loadingEl = root.querySelector<HTMLElement>("[data-today-loading]");
    const listEl = root.querySelector<HTMLElement>("[data-today-list]");
    const emptyEl = root.querySelector<HTMLElement>("[data-today-empty]");
    const loginEl = root.querySelector<HTMLElement>("[data-today-login]");
    const errorEl = root.querySelector<HTMLElement>("[data-today-error]");
    const retryBtn = root.querySelector<HTMLButtonElement>("[data-today-retry]");

    /** 面板互斥显隐：加载中 / 列表 / 空态 / 未登录引导 / 错误态 */
    const showPanel = (target: HTMLElement | null) => {
      [loadingEl, listEl, emptyEl, loginEl, errorEl]
        .filter((el): el is HTMLElement => el !== null)
        .forEach((el) => el.classList.toggle("is-hidden", el !== target));
    };

    /** 简卡：类型徽标 + evidence.explanation + 本地时间 */
    const renderCard = (event: AlertEvent): HTMLElement => {
      const card = document.createElement("article");
      card.className = "card today-event";
      const head = document.createElement("div");
      head.className = "today-event-head";
      const badge = document.createElement("span");
      badge.className = "badge badge--primary";
      badge.textContent = eventLabel(event.event_type);
      const clock = document.createElement("span");
      clock.className = "meta today-event-clock";
      clock.textContent = formatEventClock(event.created_at);
      head.append(badge, clock);
      const text = document.createElement("p");
      text.className = "meta today-event-text";
      const explanation = event.evidence?.explanation;
      text.textContent =
        typeof explanation === "string" && explanation.trim() !== "" ? explanation : "—";
      card.append(head, text);
      return card;
    };

    const load = async () => {
      showPanel(loadingEl);
      try {
        // 401 不跳转：首页展示登录引导
        const result = await listEvents({ limit: 50 }, { skipAuthRedirect: true });
        const today = todayShanghaiDate();
        const todays = result.items
          .filter((event) => eventShanghaiDate(event.created_at) === today)
          .slice(0, 3);
        if (todays.length === 0) {
          showPanel(emptyEl);
          return;
        }
        const fragment = document.createDocumentFragment();
        for (const event of todays) fragment.append(renderCard(event));
        listEl?.replaceChildren(fragment);
        showPanel(listEl);
        // 登录态下顺带同步导航未读角标
        window.dispatchEvent(
          new CustomEvent("app:unread-changed", { detail: { count: result.unread_count } }),
        );
      } catch (error) {
        if (error instanceof ApiError && error.status === 401) showPanel(loginEl);
        else showPanel(errorEl);
      }
    };

    retryBtn?.addEventListener("click", () => void load());
    void load();
  }
</script>

<style>
  .status-card {
    margin-top: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .status-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .status-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
    background: var(--color-bg);
    border-radius: var(--radius-input);
  }

  .status-num {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-brand-900);
    line-height: 1.2;
  }

  .status-num--warn {
    color: var(--color-warning);
  }

  .status-label {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .prod-note {
    margin-top: var(--space-2);
  }

  .today-events {
    margin-bottom: var(--space-3);
  }

  /* 今日事件简卡（脚本动态生成，节点无 Astro 作用域属性） */
  :global(.today-event) {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  :global(.today-event-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
  }

  :global(.today-event-clock) {
    flex-shrink: 0;
  }

  :global(.today-event-text) {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.7;
  }
</style>
