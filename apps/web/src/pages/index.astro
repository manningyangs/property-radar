---
/**
 * 首页 `/`（PRD 2.3）：5 秒内回答“今天数据是否更新、有没有与我有关的价格事件”。
 * 模块顺序：搜索 → 今日数据状态 → 数据延迟提示 → 今日与我有关 → 重点监控 →
 *          区域市场变化（口径分列）→ 最近更新小区 → 数据说明入口。
 * 生产构建（无 PUBLIC_DEMO_DATA）：全部行情模块降级为 EmptyState，零行情数字。
 */
import AppShell from "../layouts/AppShell.astro";
import GlobalSearch from "../components/GlobalSearch.astro";
import EmptyState from "../components/EmptyState.astro";
import StaleDataNotice from "../components/StaleDataNotice.astro";
import DataFreshnessBadge from "../components/DataFreshnessBadge.astro";
import PriceMetricCard from "../components/PriceMetricCard.astro";
import EventTimelineItem from "../components/EventTimelineItem.astro";
import WatchItemCard from "../components/WatchItemCard.astro";
import CommunityCard from "../components/CommunityCard.astro";
import TrendChart from "../components/TrendChart.astro";
import SourceAttribution from "../components/SourceAttribution.astro";

const demoEnabled = import.meta.env.PUBLIC_DEMO_DATA === "1";
const demo = demoEnabled ? (await import("../data/demo")).demoData : null;

const suggestions = demo
  ? [...demo.communities.map((item) => item.name), ...demo.regions.map((item) => item.name)]
  : [];
---

<AppShell title="首页" activeTab="home" demo={demoEnabled} showCity>
  {
    demo ? (
      <div class="page">
        <GlobalSearch suggestions={suggestions} />

        {/* 今日数据状态 */}
        <section class="card status-card" aria-label="今日数据状态">
          <div class="status-head">
            <span class="section-title">今日数据状态</span>
            <DataFreshnessBadge status="fresh" date={demo.freshness.lastSuccess} compact />
          </div>
          <div class="grid-2 status-grid">
            <div class="status-item">
              <span class="status-num num">{demo.freshness.communities}</span>
              <span class="status-label">覆盖小区（演示市）</span>
            </div>
            <div class="status-item">
              <span class="status-num num status-num--warn">
                {demo.freshness.delayedSources}
              </span>
              <span class="status-label">延迟数据源（需留意）</span>
            </div>
          </div>
          <p class="meta">
            最后成功更新 <span class="num">{demo.freshness.lastSuccess}</span>
            · 延迟源数量单独提示，不用“正常”颜色掩盖延迟。
          </p>
        </section>

        <StaleDataNotice
          source={demo.stale.source}
          lastValid={demo.stale.lastValid}
          days={demo.stale.days}
        />

        {/* 今日与我有关 */}
        <section aria-label="今日与我有关的事件">
          <div class="section-head">
            <h2 class="section-title">今日与我有关</h2>
            <a class="section-more" href="/events">
              全部事件 ›
            </a>
          </div>
          <div class="stack-sm">
            {demo.events.slice(0, 2).map((event) => (
              <EventTimelineItem {...event} />
            ))}
          </div>
        </section>

        {/* 我的重点监控 */}
        <section aria-label="我的重点监控">
          <div class="section-head">
            <h2 class="section-title">我的重点监控</h2>
            <a class="section-more" href="/watch">
              管理 ›
            </a>
          </div>
          <div class="stack-sm">
            {demo.watchItems.slice(0, 1).map((item) => (
              <WatchItemCard {...item} dialogId="home-watch-dialog" showActions={false} />
            ))}
          </div>
          <div class="btn-row" style="margin-top: 12px">
            <a class="btn btn--primary btn--block" href="/watch/add">
              + 快速添加监控
            </a>
          </div>
        </section>

        {/* 区域市场变化：挂牌参考与实际成交分列 */}
        <section aria-label="区域市场变化">
          <div class="section-head">
            <h2 class="section-title">区域市场变化</h2>
            <a class="section-more" href="/regions">
              区域 ›
            </a>
          </div>
          <div class="stack-sm">
            <div class="card">
              <TrendChart
                points={demo.cityMarket.series["30"] ?? []}
                metric="全市挂牌中位价趋势（挂牌参考 · 近 30 日）"
                source="演示数据源汇总"
                statDate="2026-11-10"
                trend="down"
              />
            </div>
            <div class="grid-2">
              <PriceMetricCard
                metric="挂牌参考 · 中位价"
                value={demo.cityMarket.listMedian.toLocaleString("zh-CN")}
                direction="down"
                percent={demo.cityMarket.listChange}
                statDate="2026-11-10"
                sample={demo.cityMarket.listSample}
                status={{ text: "数据正常", tone: "ok" }}
              />
              <PriceMetricCard
                metric="实际成交 · 中位价"
                value={demo.cityMarket.dealMedian.toLocaleString("zh-CN")}
                direction="down"
                percent={demo.cityMarket.dealChange}
                statDate="2026-11-10"
                sample={demo.cityMarket.dealSample}
                status={{ text: "数据正常", tone: "ok" }}
                footer="成交与挂牌口径分别呈现，不混用。"
              />
            </div>
          </div>
        </section>

        {/* 最近更新的小区 */}
        <section aria-label="最近更新的小区">
          <div class="section-head">
            <h2 class="section-title">最近更新的小区</h2>
            <a class="section-more" href="/communities">
              搜索 ›
            </a>
          </div>
          <div class="stack-sm">
            {demo.communities.slice(0, 3).map((item) => (
              <CommunityCard
                id={item.id}
                name={item.name}
                regionName={item.regionName}
                plate={item.plate}
                median={item.median}
                change30={item.change30}
                direction={item.direction}
                sample={item.sample}
                statDate={item.statDate}
                source={item.source}
                status={item.status}
              />
            ))}
          </div>
        </section>

        {/* 数据说明入口 */}
        <section aria-label="数据说明">
          <div class="section-head">
            <h2 class="section-title">数据说明</h2>
            <a class="section-more" href="/account">
              账户与隐私 ›
            </a>
          </div>
          <SourceAttribution
            metric="挂牌参考 / 实际成交（分口径）"
            source="演示数据源A / 演示数据源B（演示）"
            statDate="2026-11-10"
            collectedAt="2026-11-10 06:10"
            quality="B"
            note="示例对象均为虚构（演示市）；生产环境不会展示任何演示行情。样本不足时按质量分层降级展示。"
          />
        </section>
      </div>
    ) : (
      <div class="page">
        <GlobalSearch />

        {/* 今日数据状态（TASK-08C R1：GET /public/system/status 真实渲染） */}
        <p class="meta is-hidden" data-status-loading>正在加载数据状态…</p>
        <section class="card status-card is-hidden" aria-label="今日数据状态" data-status>
          <div class="status-head">
            <span class="section-title">今日数据状态</span>
            <span class="badge badge--neutral" data-status-freshness>—</span>
          </div>
          <div class="grid-2 status-grid">
            <div class="status-item">
              <span class="status-num num" data-status-cities>—</span>
              <span class="status-label">已接入数据城市</span>
            </div>
            <div class="status-item">
              <span class="status-num num" data-status-obs>—</span>
              <span class="status-label">累计观测样本</span>
            </div>
          </div>
          <p class="meta">
            最后成功更新 <span class="num" data-status-last>—</span>
            · 数据延迟不代表价格下跌。
          </p>
        </section>
        <div class="is-hidden" data-status-error>
          <EmptyState
            title="数据状态加载失败"
            description="无法连接数据服务；恢复之前本页不会展示任何行情数字。"
          >
            <button type="button" class="btn btn--secondary" data-status-retry>
              重新加载
            </button>
          </EmptyState>
        </div>

        {/* 今日与我有关（05A 真实事件：仅登录提示存在时调用 /me/events——R8） */}
        <section aria-label="今日与我有关的事件" class="today-events" data-today-events>
          <div class="section-head">
            <h2 class="section-title">今日与我有关</h2>
            <a class="section-more" href="/events">
              全部事件 ›
            </a>
          </div>
          <p class="meta is-hidden" data-today-loading>正在加载今日事件…</p>
          <div class="stack-sm is-hidden" data-today-list></div>
          <div class="is-hidden" data-today-empty>
            <EmptyState
              title="今天暂无新事件"
              description="监控对象的价格与数据状态今天没有变化；出现新事件时会第一时间显示在这里。"
            />
          </div>
          <div class="is-hidden" data-today-login>
            <EmptyState
              title="登录后查看今日事件"
              description="事件由你的监控对象与规则触发；登录后可查看与你有关的今日事件与未读提醒。"
              actionText="登录"
              actionHref="/login"
            />
          </div>
          <div class="is-hidden" data-today-error>
            <EmptyState
              title="今日事件加载失败"
              description="无法连接服务获取事件数据，请稍后重试。"
            >
              <button type="button" class="btn btn--secondary" data-today-retry>
                重新加载
              </button>
            </EmptyState>
          </div>
        </section>

        {/* 城市范围数据（R1：最近更新小区 / 区域提示 / 未覆盖诚实空态） */}
        <section aria-label="最近更新的小区" class="is-hidden" data-recent>
          <div class="section-head">
            <h2 class="section-title">最近更新的小区</h2>
            <a class="section-more" href="/communities">
              搜索 ›
            </a>
          </div>
          <p class="meta is-hidden" data-recent-loading>正在加载小区数据…</p>
          <div class="stack-sm is-hidden" data-recent-list></div>
          <div class="is-hidden" data-recent-empty>
            <EmptyState
              title="该城市暂无小区行情"
              description="城市已列入覆盖计划，但尚未产生有效价格快照；不会展示任何估算数字。"
              actionText="查看城市覆盖"
              actionHref="/cities"
            />
          </div>
          <div class="is-hidden" data-recent-error>
            <EmptyState
              title="小区数据加载失败"
              description="无法连接数据服务获取小区快照。"
            >
              <button type="button" class="btn btn--secondary" data-recent-retry>
                重新加载
              </button>
            </EmptyState>
          </div>
        </section>

        <section aria-label="区域市场变化" class="is-hidden" data-regionhint>
          <div class="card region-hint-card">
            <span class="section-title">区域市场变化</span>
            <p class="meta" data-regionhint-text></p>
            <a class="btn btn--secondary" href="/regions">查看区域行情 ›</a>
          </div>
        </section>

        <div class="is-hidden" data-city-empty>
          <EmptyState
            title="当前城市暂未覆盖房价数据"
            description="已选城市尚未接入真实行情；我们不展示任何演示或估算数字。可在城市目录查看覆盖状态并提交接入申请。"
            actionText="城市目录与覆盖申请"
            actionHref="/cities"
          />
        </div>

        {/* 数据说明入口（R7） */}
        <section aria-label="数据说明">
          <div class="section-head">
            <h2 class="section-title">数据说明</h2>
            <a class="section-more" href="/methodology">
              口径与来源 ›
            </a>
          </div>
          <p class="meta prod-note">
            行情仅来自已审批数据源，口径、来源与数据日期随指标展示；未覆盖城市不展示任何价格数字。
          </p>
        </section>
      </div>
    )
  }
</AppShell>

<script>
  import {
    ApiError,
    getCommunitiesCoverage,
    getCommunityPrices,
    getPublicCities,
    getSystemStatus,
    listEvents,
    searchRegions,
  } from "../lib/api";
  import type { AlertEvent, CommunityCoverageItem, PriceSnapshot } from "../lib/api";
  import { eventLabel, eventShanghaiDate, formatEventClock, todayShanghaiDate } from "../lib/events";
  import {
    CITY_CHANGE_EVENT,
    isCityCovered,
    readStoredCity,
    resolveCityScope,
    type CityScope,
  } from "../lib/city";
  import {
    formatPriceValue,
    freshnessStatus,
    isLowSample,
    latestPerMetric,
    metricLabel,
  } from "../lib/market";
  import { hasSessionHint } from "../lib/session";

  const $ = <T extends HTMLElement>(sel: string) =>
    document.querySelector<T>(sel);

  // ===== A. 今日数据状态（GET /public/system/status） =====
  const statusSection = $("[data-status]");
  if (statusSection) {
    const statusLoading = $("[data-status-loading]");
    const statusError = $("[data-status-error]");
    const show = (target: HTMLElement | null) => {
      statusLoading?.classList.toggle("is-hidden", target !== statusLoading);
      statusError?.classList.toggle("is-hidden", target !== statusError);
      statusSection.classList.toggle("is-hidden", target !== statusSection);
    };
    const loadStatus = async () => {
      show(statusLoading);
      try {
        const st = await getSystemStatus();
        $("[data-status-cities]")!.textContent = String(st.cities_data_active ?? 0);
        $("[data-status-obs]")!.textContent = (st.observations_total ?? 0).toLocaleString("zh-CN");
        const last = st.last_collected_at ?? "";
        $("[data-status-last]")!.textContent = last ? last.slice(0, 16) : "—";
        const fresh = freshnessStatus(last, Date.now());
        const badge = $("[data-status-freshness]")!;
        badge.textContent =
          fresh === "fresh" ? "数据正常" : fresh === "delayed" ? "更新延迟" : "数据过期";
        badge.className = `badge ${fresh === "fresh" ? "badge--primary" : "badge--warning"}`;
        show(statusSection);
      } catch {
        show(statusError);
      }
    };
    $("[data-status-retry]")?.addEventListener("click", () => void loadStatus());
    void loadStatus();
  }

  // ===== B. 城市范围数据（最近更新小区 / 区域提示 / 未覆盖空态） =====
  const recentSection = $("[data-recent]");
  if (recentSection) {
    const recentLoading = $("[data-recent-loading]");
    const recentList = $("[data-recent-list]");
    const recentEmpty = $("[data-recent-empty]");
    const recentError = $("[data-recent-error]");
    const regionHint = $("[data-regionhint]");
    const cityEmpty = $("[data-city-empty]");

    const showCityPanel = (target: "loading" | "list" | "empty" | "error" | "no-city") => {
      recentLoading!.classList.toggle("is-hidden", target !== "loading");
      recentList!.classList.toggle("is-hidden", target !== "list");
      recentEmpty!.classList.toggle("is-hidden", target !== "empty");
      recentError!.classList.toggle("is-hidden", target !== "error");
      recentSection!.classList.toggle("is-hidden", target === "no-city");
      regionHint!.classList.toggle("is-hidden", target !== "list" && target !== "empty");
      cityEmpty!.classList.toggle("is-hidden", target !== "no-city");
    };

    /** 小区简卡（客户端复刻 CommunityCard 结构；文本一律 textContent，防注入） */
    const renderCommunityCard = (
      item: CommunityCoverageItem,
      latest: PriceSnapshot | null,
    ): HTMLAnchorElement => {
      const card = document.createElement("a");
      card.className = "card prod-community";
      card.href = `/community?id=${encodeURIComponent(item.community_id)}`;
      card.innerHTML = `
        <div class="prod-community-head">
          <span class="prod-community-name" data-name></span>
          <span class="badge badge--neutral" data-district></span>
        </div>
        <div class="prod-community-price">
          <span class="num" data-price></span>
          <span class="meta" data-metric></span>
        </div>
        <p class="meta prod-community-foot" data-foot></p>`;
      card.querySelector("[data-name]")!.textContent = item.name;
      card.querySelector("[data-district]")!.textContent = item.district ?? "—";
      const priceEl = card.querySelector("[data-price]")!;
      const metricEl = card.querySelector("[data-metric]")!;
      const footEl = card.querySelector("[data-foot]")!;
      if (latest && latest.median !== null) {
        priceEl.textContent = formatPriceValue(latest.median, "元/㎡");
        if (isLowSample(latest.sample_count)) priceEl.classList.add("prod-community-price--weak");
        metricEl.textContent = metricLabel(latest.metric_code);
        footEl.textContent = `数据日期 ${latest.stat_date.slice(0, 10)} · 样本 ${latest.sample_count ?? "—"} 条 · 来源 ${latest.source_id ?? "—"}`;
      } else if (item.snapshot) {
        priceEl.textContent = "暂无有效快照";
        metricEl.textContent = "";
        footEl.textContent = `最近采集 ${item.snapshot.collected_at?.slice(0, 16) ?? "—"} · 样本 ${item.snapshot.sample_count ?? "—"} 条`;
      } else {
        priceEl.textContent = "暂无有效快照";
        metricEl.textContent = "";
        footEl.textContent = "该小区尚无价格快照，不展示估算数字";
      }
      return card;
    };

    let lastScopeForRetry: CityScope | null = null;

    const loadCityData = async (scope: CityScope | null) => {
      lastScopeForRetry = scope;
      if (!scope || !isCityCovered(scope.status)) {
        if (scope) {
          // 未覆盖城市：诚实空态 + 城市目录申请入口
          const title = cityEmpty!.querySelector("h2");
          const desc = cityEmpty!.querySelector("p");
          if (title) title.textContent = `${scope.name} 暂未覆盖房价数据`;
          if (desc) desc.textContent = "该城市尚未接入真实行情；我们不展示任何演示或估算数字。可在城市目录查看覆盖状态并提交接入申请。";
        }
        showCityPanel("no-city");
        return;
      }
      showCityPanel("loading");
      try {
        const [coverage, regions] = await Promise.all([
          getCommunitiesCoverage(scope.city_code),
          searchRegions(scope.city_code).catch(() => null),
        ]);
        if (regions && regions.count > 0) {
          $("[data-regionhint-text]")!.textContent =
            `${scope.name}已覆盖 ${regions.count} 个区县的行政目录，区域行情按口径分列展示。`;
        }
        const withSnapshot = coverage.items
          .filter((item) => item.snapshot !== null)
          .sort((a, b) =>
            (b.snapshot?.collected_at ?? "").localeCompare(a.snapshot?.collected_at ?? ""),
          )
          .slice(0, 3);
        if (withSnapshot.length === 0) {
          recentList!.replaceChildren();
          showCityPanel("empty");
          return;
        }
        const prices = await Promise.all(
          withSnapshot.map((item) =>
            getCommunityPrices(item.community_id, 20).catch(() => null),
          ),
        );
        const fragment = document.createDocumentFragment();
        withSnapshot.forEach((item, i) => {
          const list = prices[i]?.items ?? [];
          const latest =
            latestPerMetric(list).find(
              (s) => s.metric_code === "median_price" && s.median !== null,
            ) ?? latestPerMetric(list)[0] ?? null;
          fragment.append(renderCommunityCard(item, latest));
        });
        recentList!.replaceChildren(fragment);
        showCityPanel("list");
      } catch {
        showCityPanel("error");
      }
    };

    $("[data-recent-retry]")?.addEventListener("click", () => void loadCityData(lastScopeForRetry));

    window.addEventListener(CITY_CHANGE_EVENT, (event) => {
      void loadCityData((event as CustomEvent<CityScope | null>).detail ?? null);
    });

    // 初始范围：本地已选城市优先；否则接目录取第一个 active（与徽标同源逻辑）
    const stored = readStoredCity();
    if (stored) {
      void loadCityData(stored);
    } else {
      void (async () => {
        try {
          const res = await getPublicCities({ limit: 50 });
          void loadCityData(
            resolveCityScope(
              res.items.map((c) => ({ city_code: c.city_code, name: c.name, status: c.status })),
            ),
          );
        } catch {
          showCityPanel("error");
        }
      })();
    }
  }

  // ===== C. 今日与我有关（R8：游客零 /me 请求） =====
  const root = document.querySelector<HTMLElement>("[data-today-events]");

  if (root) {
    const loadingEl = root.querySelector<HTMLElement>("[data-today-loading]");
    const listEl = root.querySelector<HTMLElement>("[data-today-list]");
    const emptyEl = root.querySelector<HTMLElement>("[data-today-empty]");
    const loginEl = root.querySelector<HTMLElement>("[data-today-login]");
    const errorEl = root.querySelector<HTMLElement>("[data-today-error]");
    const retryBtn = root.querySelector<HTMLButtonElement>("[data-today-retry]");

    /** 面板互斥显隐：加载中 / 列表 / 空态 / 未登录引导 / 错误态 */
    const showPanel = (target: HTMLElement | null) => {
      [loadingEl, listEl, emptyEl, loginEl, errorEl]
        .filter((el): el is HTMLElement => el !== null)
        .forEach((el) => el.classList.toggle("is-hidden", el !== target));
    };

    /** 简卡：类型徽标 + evidence.explanation + 本地时间 */
    const renderCard = (event: AlertEvent): HTMLElement => {
      const card = document.createElement("article");
      card.className = "card today-event";
      const head = document.createElement("div");
      head.className = "today-event-head";
      const badge = document.createElement("span");
      badge.className = "badge badge--primary";
      badge.textContent = eventLabel(event.event_type);
      const clock = document.createElement("span");
      clock.className = "meta today-event-clock";
      clock.textContent = formatEventClock(event.created_at);
      head.append(badge, clock);
      const text = document.createElement("p");
      text.className = "meta today-event-text";
      const explanation = event.evidence?.explanation;
      text.textContent =
        typeof explanation === "string" && explanation.trim() !== "" ? explanation : "—";
      card.append(head, text);
      return card;
    };

    const load = async () => {
      // TASK-08C R8：游客（无登录提示）直接展示登录引导，不发 /me/events
      if (!hasSessionHint()) {
        showPanel(loginEl);
        return;
      }
      showPanel(loadingEl);
      try {
        // 401 不跳转：首页展示登录引导
        const result = await listEvents({ limit: 50 }, { skipAuthRedirect: true });
        const today = todayShanghaiDate();
        const todays = result.items
          .filter((event) => eventShanghaiDate(event.created_at) === today)
          .slice(0, 3);
        if (todays.length === 0) {
          showPanel(emptyEl);
          return;
        }
        const fragment = document.createDocumentFragment();
        for (const event of todays) fragment.append(renderCard(event));
        listEl?.replaceChildren(fragment);
        showPanel(listEl);
        // 登录态下顺带同步导航未读角标
        window.dispatchEvent(
          new CustomEvent("app:unread-changed", { detail: { count: result.unread_count } }),
        );
      } catch (error) {
        if (error instanceof ApiError && error.status === 401) showPanel(loginEl);
        else showPanel(errorEl);
      }
    };

    retryBtn?.addEventListener("click", () => void load());
    void load();
  }
</script>

