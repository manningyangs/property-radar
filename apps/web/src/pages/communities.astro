---
/**
 * 小区搜索 `/communities`（PRD 2.2 页面视觉布局“小区搜索”）：
 * 搜索框置顶 → 区县/板块筛选 → 排序（价格/涨跌/样本数）→ 小区结果卡。
 * q/district/sort 通过 query 参数携带，静态构建由客户端脚本执行过滤与排序。
 */
import AppShell from "../layouts/AppShell.astro";
import EmptyState from "../components/EmptyState.astro";
import CommunityCard from "../components/CommunityCard.astro";

const demoEnabled = import.meta.env.PUBLIC_DEMO_DATA === "1";
const demo = demoEnabled ? (await import("../data/demo")).demoData : null;

const districts = demo ? [{ id: "all", name: "全部区县" }, ...demo.regions.map((r) => ({ id: r.id, name: r.name }))] : [];

const sorts = [
  { key: "default", label: "默认" },
  { key: "price", label: "价格 ↑" },
  { key: "change", label: "涨跌" },
  { key: "sample", label: "样本数" },
];
---

<AppShell title="小区搜索" activeTab="communities" demo={demoEnabled} backHref="/">
  {
    demo ? (
      <div class="page" data-community-list>
        {/* 搜索框置顶 */}
        <form class="csearch-form" action="/communities" method="get" role="search">
          <label class="csearch-label" for="csearch-input">
            <span class="sr-only">搜索小区</span>
            <input
              type="search"
              id="csearch-input"
              name="q"
              class="input"
              placeholder="输入小区名，如：晴川花园（演示）"
              data-community-search
              autocomplete="off"
            />
          </label>
          <button type="submit" class="btn btn--primary csearch-btn">
            搜索
          </button>
        </form>
        <p class="meta">
          同名小区以行政区后缀消歧；仅展示已核验字段，未覆盖对象不会出现在结果中。
        </p>

        {/* 区县筛选 */}
        <div class="chip-row" role="group" aria-label="区县筛选">
          {districts.map((district) => (
            <button
              type="button"
              class:list={["chip", district.id === "all" && "is-active"]}
              data-filter-district={district.id}
              aria-pressed={district.id === "all" ? "true" : "false"}
            >
              {district.name}
            </button>
          ))}
        </div>

        {/* 排序 */}
        <div class="chip-row" role="group" aria-label="排序方式">
          {sorts.map((sort) => (
            <button
              type="button"
              class:list={["chip", sort.key === "default" && "is-active"]}
              data-sort={sort.key}
              aria-pressed={sort.key === "default" ? "true" : "false"}
            >
              {sort.label}
            </button>
          ))}
        </div>

        <p class="meta result-count" data-result-count />

        <div class="stack-sm" data-community-results>
          {demo.communities.map((item) => (
            <div data-community-item data-name={item.name} data-district={item.regionId}>
              <CommunityCard
                id={item.id}
                name={item.name}
                regionName={item.regionName}
                plate={item.plate}
                median={item.median}
                change30={item.change30}
                direction={item.direction}
                sample={item.sample}
                statDate={item.statDate}
                source={item.source}
                status={item.status}
              />
            </div>
          ))}
        </div>

        <div class="is-hidden" data-community-empty>
          <EmptyState
            title="没有匹配的小区"
            description="换个关键词，或清除区县筛选；若目标小区未覆盖，可提交补录申请。"
            actionText="登录后提交覆盖申请"
            actionHref="/login"
          />
        </div>
      </div>
    ) : (
      <div class="page" data-prod-communities>
        <form class="csearch-form" action="/communities" method="get" role="search">
          <label class="csearch-label" for="csearch-input-prod">
            <span class="sr-only">搜索小区</span>
            <input
              type="search"
              id="csearch-input-prod"
              name="q"
              class="input"
              placeholder="输入小区名，如：万科（真实目录检索）"
              data-prod-q
              autocomplete="off"
            />
          </label>
          <button type="submit" class="btn btn--primary csearch-btn">
            搜索
          </button>
        </form>
        <p class="meta">
          检索真实小区目录，结果限定当前城市范围；未覆盖城市不展示任何估算数字。
        </p>

        <p class="meta is-hidden" data-prod-loading>正在检索小区…</p>
        <p class="meta result-count is-hidden" data-prod-count></p>
        <div class="stack-sm is-hidden" data-prod-results></div>
        <div class="is-hidden" data-prod-empty>
          <EmptyState
            title="没有匹配的小区"
            description="换个关键词试试；若目标小区尚未覆盖，可在城市目录页提交覆盖申请。"
            actionText="城市目录与覆盖申请"
            actionHref="/cities"
          />
        </div>
        <div class="is-hidden" data-prod-error>
          <EmptyState
            title="小区检索失败"
            description="无法连接数据服务；恢复之前不会展示任何行情结果。"
          >
            <button type="button" class="btn btn--secondary" data-prod-retry>
              重新搜索
            </button>
          </EmptyState>
        </div>
        <div class="is-hidden" data-city-empty>
          <EmptyState
            title="当前城市暂未覆盖房价数据"
            description="已选城市尚未接入小区目录；可在城市目录查看覆盖状态并提交接入申请。"
            actionText="城市目录与覆盖申请"
            actionHref="/cities"
          />
        </div>
      </div>
    )
  }
</AppShell>

<script>
  import {
    getPublicCities,
    getPublicCommunities,
    searchRegions,
  } from "../lib/api";
  import {
    CITY_CHANGE_EVENT,
    isCityCovered,
    readStoredCity,
    resolveCityScope,
    type CityScope,
  } from "../lib/city";

  const items = Array.from(
    document.querySelectorAll<HTMLElement>("[data-community-item]"),
  );
  const results = document.querySelector<HTMLElement>("[data-community-results]");
  const empty = document.querySelector<HTMLElement>("[data-community-empty]");
  const countEl = document.querySelector<HTMLElement>("[data-result-count]");
  const searchInput = document.querySelector<HTMLInputElement>("[data-community-search]");

  const params = new URLSearchParams(window.location.search);
  let query = params.get("q") ?? "";
  let district = params.get("district") ?? "all";
  let sort = params.get("sort") ?? "default";

  if (searchInput) searchInput.value = query;

  const syncUrl = () => {
    const url = new URL(window.location.href);
    if (query) url.searchParams.set("q", query);
    else url.searchParams.delete("q");
    if (district !== "all") url.searchParams.set("district", district);
    else url.searchParams.delete("district");
    if (sort !== "default") url.searchParams.set("sort", sort);
    else url.searchParams.delete("sort");
    window.history.replaceState({}, "", url);
  };

  const apply = () => {
    let visible = 0;
    const matched: HTMLElement[] = [];

    for (const item of items) {
      const name = item.dataset.name ?? "";
      const itemDistrict = item.dataset.district ?? "";
      const matchQuery = !query || name.toLowerCase().includes(query.toLowerCase());
      const matchDistrict = district === "all" || itemDistrict === district;
      const show = matchQuery && matchDistrict;
      item.classList.toggle("is-hidden", !show);
      if (show) {
        visible += 1;
        matched.push(item);
      }
    }

    // 排序（价格缺失者排最后，不以其他对象数字顶替）
    if (sort !== "default" && results) {
      const priceOf = (el: HTMLElement) => {
        const node = el.querySelector<HTMLElement>(".ccard-price");
        return node
          ? Number((node.textContent ?? "0").replace(/,/g, ""))
          : Number.POSITIVE_INFINITY;
      };
      const changeOf = (el: HTMLElement) => {
        const card = el.querySelector<HTMLElement>(".ccard");
        const match = (card?.textContent ?? "").match(/(上涨|下降)(\d+\.\d)%/);
        if (!match?.[2]) return 0;
        const value = Number(match[2]);
        return match[1] === "下降" ? -value : value;
      };
      const sampleOf = (el: HTMLElement) => {
        const match = (el.textContent ?? "").match(/n=(\d+)/);
        return match?.[1] ? Number(match[1]) : 0;
      };

      const sorted = [...matched].sort((a, b) => {
        if (sort === "price") return priceOf(a) - priceOf(b);
        if (sort === "change") return changeOf(a) - changeOf(b);
        if (sort === "sample") return sampleOf(b) - sampleOf(a);
        return 0;
      });
      for (const el of sorted) results.appendChild(el);
    }

    if (countEl) {
      countEl.textContent = `共 ${visible} 个结果${query ? ` · 关键词“${query}”` : ""}`;
    }
    empty?.classList.toggle("is-hidden", visible > 0);
  };

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;

    const districtChip = target.closest<HTMLElement>("[data-filter-district]");
    if (districtChip) {
      district = districtChip.dataset.filterDistrict ?? "all";
      document.querySelectorAll<HTMLElement>("[data-filter-district]").forEach((chip) => {
        const active = chip === districtChip;
        chip.classList.toggle("is-active", active);
        chip.setAttribute("aria-pressed", active ? "true" : "false");
      });
      syncUrl();
      apply();
      return;
    }

    const sortChip = target.closest<HTMLElement>("[data-sort]");
    if (sortChip) {
      sort = sortChip.dataset.sort ?? "default";
      document.querySelectorAll<HTMLElement>("[data-sort]").forEach((chip) => {
        const active = chip === sortChip;
        chip.classList.toggle("is-active", active);
        chip.setAttribute("aria-pressed", active ? "true" : "false");
      });
      syncUrl();
      apply();
    }
  });

  // 首次进入按 URL 参数应用筛选/排序（支持从首页搜索框 GET 跳转）
  if (items.length > 0) {
    document
      .querySelectorAll<HTMLElement>("[data-filter-district]")
      .forEach((chip) => {
        const active = (chip.dataset.filterDistrict ?? "all") === district;
        chip.classList.toggle("is-active", active);
        chip.setAttribute("aria-pressed", active ? "true" : "false");
      });
    document.querySelectorAll<HTMLElement>("[data-sort]").forEach((chip) => {
      const active = (chip.dataset.sort ?? "default") === sort;
      chip.classList.toggle("is-active", active);
      chip.setAttribute("aria-pressed", active ? "true" : "false");
    });
    apply();
  }

  // ===== TASK-08C R4：生产小区检索（GET /public/communities?q=&region_id=） =====
  const prodRoot = document.querySelector<HTMLElement>("[data-prod-communities]");
  if (prodRoot) {
    const loadingEl = prodRoot.querySelector<HTMLElement>("[data-prod-loading]");
    const countEl = prodRoot.querySelector<HTMLElement>("[data-prod-count]");
    const resultsEl = prodRoot.querySelector<HTMLElement>("[data-prod-results]");
    const emptyEl = prodRoot.querySelector<HTMLElement>("[data-prod-empty]");
    const errorEl = prodRoot.querySelector<HTMLElement>("[data-prod-error]");
    const cityEmptyEl = prodRoot.querySelector<HTMLElement>("[data-city-empty]");
    const qInput = prodRoot.querySelector<HTMLInputElement>("[data-prod-q]");
    const form = prodRoot.querySelector<HTMLFormElement>(".csearch-form");

    const show = (
      target: "loading" | "list" | "empty" | "error" | "no-city",
    ) => {
      loadingEl?.classList.toggle("is-hidden", target !== "loading");
      countEl?.classList.toggle("is-hidden", target !== "list" && target !== "empty");
      resultsEl?.classList.toggle("is-hidden", target !== "list");
      emptyEl?.classList.toggle("is-hidden", target !== "empty");
      errorEl?.classList.toggle("is-hidden", target !== "error");
      cityEmptyEl?.classList.toggle("is-hidden", target !== "no-city");
    };

    let scope: CityScope | null = null;
    let regionId = new URLSearchParams(window.location.search).get("region_id") ?? "";

    const load = async () => {
      if (!scope || !isCityCovered(scope.status)) {
        show("no-city");
        return;
      }
      show("loading");
      try {
        const q = qInput?.value.trim() ?? "";
        const [res, regions] = await Promise.all([
          getPublicCommunities({
            q: q || undefined,
            region_id: regionId || undefined,
            limit: 50,
          }),
          searchRegions(scope.city_code).catch(() => null),
        ]);
        const districtNames = new Map(
          (regions?.items ?? []).map((r) => [r.region_id, r.name]),
        );
        // 后端无 city_code 过滤参数：客户端按当前范围过滤，绝不跨城混排
        const items = res.items.filter((item) => item.city_code === scope?.city_code);
        if (countEl) {
          countEl.textContent = `共 ${items.length} 个小区${q ? ` · 关键词“${q}”` : ""}${
            regionId && districtNames.has(regionId)
              ? ` · ${districtNames.get(regionId)}`
              : ""
          }`;
        }
        if (items.length === 0) {
          show("empty");
          return;
        }
        const fragment = document.createDocumentFragment();
        for (const item of items) {
          const row = document.createElement("a");
          row.className = "card prod-comm-row";
          row.href = `/community?id=${encodeURIComponent(item.community_id)}`;
          const name = document.createElement("span");
          name.className = "prod-comm-name";
          name.textContent = item.name;
          const district = document.createElement("span");
          district.className = "badge badge--neutral";
          district.textContent =
            districtNames.get(item.region_id) ?? item.block_name ?? "—";
          const sub = document.createElement("span");
          sub.className = "meta prod-comm-sub";
          sub.textContent = `建成 ${item.built_year ?? "—"} · 目录更新 ${item.updated_at?.slice(0, 10) ?? "—"}`;
          row.append(name, district, sub);
          fragment.append(row);
        }
        resultsEl?.replaceChildren(fragment);
        show("list");
      } catch {
        show("error");
      }
    };

    const syncUrl = () => {
      const url = new URL(window.location.href);
      const q = qInput?.value.trim() ?? "";
      if (q) url.searchParams.set("q", q);
      else url.searchParams.delete("q");
      if (regionId) url.searchParams.set("region_id", regionId);
      else url.searchParams.delete("region_id");
      window.history.replaceState({}, "", url);
    };

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      regionId = "";
      syncUrl();
      void load();
    });

    prodRoot
      .querySelector<HTMLButtonElement>("[data-prod-retry]")
      ?.addEventListener("click", () => void load());

    window.addEventListener(CITY_CHANGE_EVENT, (event) => {
      scope = (event as CustomEvent<CityScope | null>).detail ?? null;
      regionId = "";
      void load();
    });

    const stored = readStoredCity();
    const initialQ = new URLSearchParams(window.location.search).get("q");
    if (initialQ && qInput) qInput.value = initialQ;
    if (stored) {
      scope = stored;
      void load();
    } else {
      void (async () => {
        try {
          const res = await getPublicCities({ limit: 50 });
          scope = resolveCityScope(
            res.items.map((c) => ({ city_code: c.city_code, name: c.name, status: c.status })),
          );
        } catch {
          show("error");
          return;
        }
        void load();
      })();
    }
  }
</script>

<style>
  .csearch-form {
    display: flex;
    gap: var(--space-1);
    align-items: center;
    margin-bottom: var(--space-1);
  }

  .csearch-label {
    flex: 1;
    min-width: 0;
  }

  .csearch-btn {
    flex-shrink: 0;
  }

  .result-count {
    margin-top: var(--space-1);
  }

  [data-community-item] {
    display: block;
  }

  /* TASK-08C：生产检索结果行（脚本动态生成，节点无作用域属性） */
  :global(.prod-comm-row) {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    color: inherit;
    text-decoration: none;
  }

  :global(.prod-comm-name) {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    color: var(--color-brand-900);
  }

  :global(.prod-comm-sub) {
    width: 100%;
  }
</style>
