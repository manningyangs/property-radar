---
/**
 * 账户与隐私 `/account`（PRD 2.9）：
 * 邮箱与演示会话、通知渠道（浏览器推送使用真实 Notification 权限状态，拒绝即降级说明）、
 * 覆盖申请入口（本地演示 + 诚实确认文案）、隐私与数据说明 `#privacy`、
 * 数据导出/删除本地收藏/注销（ConfirmDialog 二次确认或“暂未开放”标注）。
 * 本页不含行情数字，因此演示与默认构建共用同一框架（仅数据说明区块分支）。
 */
import AppShell from "../layouts/AppShell.astro";
import SourceAttribution from "../components/SourceAttribution.astro";
import EmptyState from "../components/EmptyState.astro";
import ConfirmDialog from "../components/ConfirmDialog.astro";

const demoEnabled = import.meta.env.PUBLIC_DEMO_DATA === "1";
const demo = demoEnabled ? (await import("../data/demo")).demoData : null;

const channels = [
  { key: "digest", label: "每日摘要邮件", hint: "每日一封，汇总全部监控对象变化" },
  { key: "alert", label: "目标价触发邮件", hint: "达到目标价时立即发送；失败仍保留站内事件" },
  { key: "site", label: "站内事件", hint: "事件中心始终留存，不依赖邮件送达" },
];
---

<AppShell title="账户与隐私" activeTab="watch" demo={demoEnabled} backHref="/">
  <div class="page account-page">
    {/* ===== 账户与会话 ===== */}
    <section class="card acc-card" aria-labelledby="acc-session">
      <div class="acc-head">
        <h2 class="section-title" id="acc-session">账户</h2>
        <span class="badge badge--neutral" data-session-badge>游客模式</span>
      </div>
      <dl class="acc-dl">
        <div class="acc-row">
          <dt>邮箱</dt>
          <dd data-account-email>未登录</dd>
        </div>
        <div class="acc-row">
          <dt>会话</dt>
          <dd>演示会话仅保存在当前设备，不向任何服务器发送邮箱</dd>
        </div>
      </dl>
      <div class="btn-row">
        <button type="button" class="btn btn--secondary" data-signout>退出登录</button>
        <a class="btn btn--secondary" href="/login">邮箱验证码登录</a>
      </div>
    </section>

    {/* ===== 通知渠道 ===== */}
    <section class="card acc-card" aria-labelledby="acc-channels">
      <h2 class="section-title" id="acc-channels">通知渠道</h2>
      <p class="meta">开关立即保存在本设备；浏览器推送需要系统权限，被拒绝不影响其它渠道。</p>
      <div class="channel-list">
        {
          channels.map((channel) => (
            <label class="channel-row">
              <input type="checkbox" data-channel={channel.key} checked />
              <span class="channel-text">
                <span class="channel-label">{channel.label}</span>
                <span class="meta">{channel.hint}</span>
              </span>
            </label>
          ))
        }
        {/* 浏览器推送：读取真实 Notification 权限状态 */}
        <div class="channel-row">
          <span class="channel-text">
            <span class="channel-label">浏览器推送</span>
            <span class="meta" data-push-hint>读取权限状态…</span>
          </span>
          <span class="badge badge--neutral" data-push-status>检测中</span>
          <button type="button" class="btn btn--sm btn--secondary" data-push-request>
            开启
          </button>
        </div>
      </div>
      <p class="push-note is-hidden" data-push-denied>
        浏览器通知已被拒绝：已自动降级为邮件 + 站内事件，其它渠道不受影响；如需开启请在浏览器地址栏的站点设置中允许通知。
      </p>
    </section>

    {/* ===== 覆盖申请 ===== */}
    <section class="card acc-card" aria-labelledby="acc-apply">
      <h2 class="section-title" id="acc-apply">提交覆盖申请</h2>
      <p class="meta">未开通的城市或小区可提交申请，审核通过后进入覆盖计划。</p>
      <form class="stack-sm apply-form" data-apply-form novalidate>
        <div class="field">
          <label class="field-label" for="apply-city">城市（必填）</label>
          <input
            type="text"
            id="apply-city"
            class="input"
            placeholder="如：你所在的城市"
            autocomplete="address-level2"
            data-apply-city
          />
          <p class="field-error" data-apply-error>请填写城市名称</p>
        </div>
        <div class="field">
          <label class="field-label" for="apply-object">小区 / 板块（选填）</label>
          <input
            type="text"
            id="apply-object"
            class="input"
            placeholder="留空则申请城市级覆盖"
            autocomplete="off"
            data-apply-object
          />
        </div>
        <div class="field">
          <label class="field-label" for="apply-note">补充说明（选填）</label>
          <textarea
            class="input apply-textarea"
            id="apply-note"
            placeholder="数据源线索、期望更新频率…"
            data-apply-note></textarea>
        </div>
        <button type="submit" class="btn btn--primary btn--block">提交申请</button>
        <p class="meta">演示环境：申请仅记录在本页面，不会真实提交到服务器。</p>
      </form>
      <div class="stack-sm apply-done is-hidden" data-apply-done role="status">
        <span class="badge badge--down">申请已记录（演示）</span>
        <p class="meta">
          已收到「<span data-apply-summary class="apply-summary"></span>」的覆盖申请。
          当前为演示构建，不会进入真实审核队列；正式环境将由管理员在后台审核并写入审计日志。
        </p>
        <button type="button" class="btn btn--secondary" data-apply-again>再提交一条</button>
      </div>
    </section>

    {/* ===== 隐私与数据说明 ===== */}
    <section class="card acc-card" id="privacy" aria-labelledby="acc-privacy">
      <h2 class="section-title" id="acc-privacy">隐私与数据说明</h2>
      <ul class="privacy-list">
        <li>监控清单与规则登录后保存在云端并跨设备同步；未登录时的收藏仅保存在当前设备。</li>
        <li>邮箱默认脱敏，仅用于登录验证与你订阅的事件通知，不会用于营销。</li>
        <li>
          价格数据均标注口径、来源、统计日期与样本量；样本不足时明确显示“数据不足”，不以其它对象数字填充。
        </li>
        <li>
          处理目的、保存期限与你的权利详见<a href="/privacy">隐私政策</a>与<a href="/terms">用户协议</a>。
        </li>
      </ul>
      {
        demo ? (
          <SourceAttribution
            metric="挂牌参考中位价（与实际成交口径分别呈现）"
            source="演示数据源A/B（虚构）"
            statDate="2026-11-10"
            collectedAt="2026-11-10 06:10"
            quality="B"
          />
        ) : (
          <EmptyState
            title="暂未覆盖，可提交覆盖申请"
            description="当前构建未接入数据源，没有可展示的行情数据说明。接入后此处将显示口径、来源与质量等级。"
            actionText="登录后提交覆盖申请"
            actionHref="/login"
          />
        )
      }
    </section>

    {/* ===== 数据与账户操作 ===== */}
    <section class="card acc-card" aria-labelledby="acc-ops">
      <h2 class="section-title" id="acc-ops">数据与账户操作</h2>
      <div class="op-list">
        <div class="op-row">
          <span class="op-text">
            导出我的监控与规则数据
            <span class="meta">JSON 单文件，含对象、规则、事件、通知偏好与同意记录</span>
          </span>
          <button type="button" class="btn btn--sm btn--secondary" data-export>
            导出
          </button>
        </div>
        <div class="op-row">
          <span class="op-text">
            删除本设备的本地收藏
            <span class="meta">仅当前设备；云端监控清单不受影响</span>
          </span>
          <button type="button" class="btn btn--sm btn--secondary" data-dialog-open="account-clear">
            删除
          </button>
        </div>
        <div class="op-row">
          <span class="op-text">
            隐私政策与用户协议
            <span class="meta">数据处理、保存期限、你的权利与第三方处理者说明</span>
          </span>
          <span class="op-actions">
            <a class="btn btn--sm btn--secondary" href="/privacy">隐私政策</a>
            <a class="btn btn--sm btn--secondary" href="/terms">用户协议</a>
          </span>
        </div>
        <div class="op-row op-row--danger">
          <span class="op-text">
            注销账号
            <span class="meta">会话即时失效；7 天内重新登录可撤销，到期云端数据永久删除</span>
          </span>
          <button type="button" class="btn btn--sm btn--danger" data-dialog-open="account-delete">
            注销
          </button>
        </div>
      </div>
    </section>

    <ConfirmDialog
      id="account-clear"
      title="删除本地收藏"
      message="将清除保存在当前设备的全部本地收藏与浏览偏好。此操作不影响云端监控清单与规则。"
      confirmText="确认删除"
      danger
    />
    <ConfirmDialog
      id="account-delete"
      title="注销账号"
      message="确认后：该账号全部登录会话立即失效，事件与邮件通知停止。7 天内重新登录可撤销注销；未撤销则到期后云端监控对象、规则、事件、通知偏好与邮箱将被永久删除（安全审计日志依合规保留）。详见隐私政策。"
      confirmText="确认注销"
      danger
    />
  </div>
</AppShell>

<script>
  // 会话 / 通知渠道 / 浏览器推送权限 / 覆盖申请（全部本地真实交互 + 诚实演示声明）
  const EMAIL_KEY = "pr:session:email";
  const CHANNEL_KEY = "pr:channels";

  const toast = (message: string) => {
    window.dispatchEvent(new CustomEvent("app:toast", { detail: { message } }));
  };

  // ===== 会话 =====
  const renderSession = () => {
    const email = window.localStorage.getItem(EMAIL_KEY);
    const emailEl = document.querySelector<HTMLElement>("[data-account-email]");
    const badge = document.querySelector<HTMLElement>("[data-session-badge]");
    if (emailEl) emailEl.textContent = email ?? "未登录";
    if (badge) {
      badge.textContent = email ? "已登录（演示）" : "游客模式";
      badge.className = `badge ${email ? "badge--primary" : "badge--neutral"}`;
    }
  };
  renderSession();

  document.querySelector<HTMLButtonElement>("[data-signout]")?.addEventListener("click", () => {
    if (!window.localStorage.getItem(EMAIL_KEY)) {
      toast("当前未登录");
      return;
    }
    window.localStorage.removeItem(EMAIL_KEY);
    // TASK-08C R8：清除登录提示，游客页面不再调用 /me/*
    try {
      window.localStorage.removeItem("pr_session_hint");
    } catch {
      /* 存储不可用忽略 */
    }
    // TASK-01C：登出时清理私有客户端缓存（pr:* 本机存储 + SW 页面/meta 缓存）
    void (
      window as unknown as { __prPurgePrivateCache?: () => Promise<void> }
    ).__prPurgePrivateCache?.();
    renderSession();
    toast("已退出登录（本设备会话与缓存已清除）");
  });

  // ===== 通知渠道（保存到本设备） =====
  const channelBoxes = Array.from(
    document.querySelectorAll<HTMLInputElement>("[data-channel]"),
  );

  const saveChannels = () => {
    const value: Record<string, boolean> = {};
    channelBoxes.forEach((box) => {
      value[box.dataset.channel ?? ""] = box.checked;
    });
    window.localStorage.setItem(CHANNEL_KEY, JSON.stringify(value));
    toast("通知渠道已保存到本设备");
  };

  try {
    const raw = window.localStorage.getItem(CHANNEL_KEY);
    if (raw) {
      const saved = JSON.parse(raw) as Record<string, boolean>;
      channelBoxes.forEach((box) => {
        const key = box.dataset.channel ?? "";
        if (key in saved) box.checked = saved[key] === true;
      });
    }
  } catch {
    // 本机存储内容损坏时回退为默认勾选，不阻塞页面
  }
  channelBoxes.forEach((box) => box.addEventListener("change", saveChannels));

  // ===== 浏览器推送（TASK-05C spec §5.1）：五态状态机（读取不触发弹窗） =====
  // 状态：不支持 / 已开启（granted+订阅+enabled=1）/ 已授权（granted 但未订阅或未开启）
  //       / 已拒绝 / 未授权（default）。requestPermission 仅在「开启」click 内调用。
  const DEMO_PUSH = import.meta.env.PUBLIC_DEMO_DATA === "1";
  const PUSH_SUB_ID_KEY = "pr:push:subscription_id";

  const pushHint = document.querySelector<HTMLElement>("[data-push-hint]");
  const pushBadge = document.querySelector<HTMLElement>("[data-push-status]");
  const pushDenied = document.querySelector<HTMLElement>("[data-push-denied]");
  const pushBtn = document.querySelector<HTMLButtonElement>("[data-push-request]");

  type PushApi = typeof import("../lib/api");
  let apiMod: PushApi | null = null;
  // 按需加载 API 模块：未启用真实交互前不引入额外请求（DEMO 完全不打真实 API）
  const loadApi = async (): Promise<PushApi> => {
    apiMod ??= await import("../lib/api");
    return apiMod;
  };

  const setPushBadge = (text: string, cls: string) => {
    if (pushBadge) {
      pushBadge.textContent = text;
      pushBadge.className = `badge ${cls}`;
    }
  };

  /** 读取 browser_push_enabled（未登录 401 → 视为未开启，不跳转） */
  async function readPushEnabled(): Promise<boolean> {
    if (DEMO_PUSH) return false;
    try {
      const { getNotificationPreferences } = await loadApi();
      const res = await getNotificationPreferences();
      return res.preferences.browser_push_enabled;
    } catch {
      return false; // 401/网络失败：按未开启渲染，点击时再走既有 401 跳转
    }
  }

  /** 当前是否有有效推送订阅（未注册 SW 视为无订阅，不阻塞等待） */
  async function readSubscription(): Promise<PushSubscription | null> {
    if (!("serviceWorker" in navigator) || !("PushManager" in window)) return null;
    const reg = await navigator.serviceWorker.getRegistration();
    if (!reg?.pushManager) return null;
    return reg.pushManager.getSubscription();
  }

  async function renderPush(): Promise<void> {
    // 不支持：无 Notification / 无 PushManager / 非安全上下文（iOS Safari 需 PWA）
    if (
      typeof window.Notification === "undefined" ||
      !("PushManager" in window) ||
      !window.isSecureContext
    ) {
      setPushBadge("环境不支持", "badge--neutral");
      if (pushHint)
        pushHint.textContent = "当前环境不支持浏览器推送，可改用邮件与站内事件。";
      if (pushBtn) pushBtn.disabled = true;
      return;
    }
    const permission = window.Notification.permission;
    if (permission === "denied") {
      setPushBadge("已拒绝", "badge--danger");
      if (pushHint) pushHint.textContent = "权限已被拒绝，无法再次弹出授权。";
      pushDenied?.classList.remove("is-hidden");
      if (pushBtn) pushBtn.disabled = true;
      return;
    }
    pushDenied?.classList.add("is-hidden");
    if (permission === "default") {
      setPushBadge("未授权", "badge--warning");
      if (pushHint) pushHint.textContent = "点击“开启”向浏览器申请通知权限。";
      if (pushBtn) {
        pushBtn.disabled = false;
        pushBtn.textContent = "开启";
      }
      return;
    }
    // permission=granted：区分「已开启」与「已授权未开启」
    const [subscription, enabled] = await Promise.all([
      readSubscription(),
      readPushEnabled(),
    ]);
    if (subscription && enabled) {
      setPushBadge("已开启", "badge--down");
      if (pushHint) pushHint.textContent = "达到目标价时会推送到系统通知，可随时关闭。";
      if (pushBtn) {
        pushBtn.disabled = false;
        pushBtn.textContent = "关闭";
      }
    } else {
      setPushBadge("已授权", "badge--down");
      if (pushHint) pushHint.textContent = "权限已授予，点击“开启”完成订阅。";
      if (pushBtn) {
        pushBtn.disabled = false;
        pushBtn.textContent = "开启";
      }
    }
  }
  void renderPush();

  /** base64url → Uint8Array（pushManager.subscribe 的 applicationServerKey） */
  function urlBase64ToUint8Array(base64: string): Uint8Array<ArrayBuffer> {
    const padding = "=".repeat((4 - (base64.length % 4)) % 4);
    const raw = atob((base64 + padding).replace(/-/g, "+").replace(/_/g, "/"));
    const out = new Uint8Array(new ArrayBuffer(raw.length));
    for (let i = 0; i < raw.length; i += 1) out[i] = raw.charCodeAt(i);
    return out;
  }

  /** 「开启」：requestPermission（仅此触发弹窗）→ 订阅 → 存库 → enabled 联动 */
  async function enablePush(): Promise<void> {
    if (typeof window.Notification === "undefined") return;
    if (DEMO_PUSH) {
      // 演示模式：仅本地权限演示，不打真实 API、不真实订阅
      const result = await window.Notification.requestPermission();
      toast(
        result === "granted"
          ? "演示环境不会真实订阅（仅本地权限演示）"
          : result === "denied"
            ? "已拒绝：演示环境自动降级为邮件 + 站内事件"
            : "未选择权限，可随时再试",
      );
      await renderPush();
      return;
    }
    const api = await loadApi();
    // 1) 只在 click 中申请权限
    const result = await window.Notification.requestPermission();
    if (result !== "granted") {
      toast(
        result === "denied"
          ? "已拒绝：自动降级为邮件 + 站内事件"
          : "未选择权限，可随时再试",
      );
      await renderPush();
      return;
    }
    try {
      // 2) 拉取 VAPID 公钥（未配置 → 提示并保持既有渠道）
      let subscription = await readSubscription();
      if (!subscription) {
        const cfg = await api.getPushConfig();
        if (!cfg.enabled || !cfg.public_key) {
          toast("推送服务未配置，请改用邮件与站内事件");
          await renderPush();
          return;
        }
        if (!("serviceWorker" in navigator)) throw new Error("无 Service Worker");
        const reg = await navigator.serviceWorker.ready;
        // 3) 浏览器订阅
        subscription = await reg.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(cfg.public_key),
        });
      }
      const json = subscription.toJSON();
      if (!json.endpoint || !json.keys?.p256dh || !json.keys?.auth) {
        throw new Error("订阅数据不完整");
      }
      // 4) 存库（返回 subscription_id 供关闭时删除）→ 5) 联动 enabled=1
      const created = await api.createPushSubscription(json.endpoint, {
        p256dh: json.keys.p256dh,
        auth: json.keys.auth,
      });
      window.localStorage.setItem(PUSH_SUB_ID_KEY, created.subscription_id);
      await api.patchNotificationPreferences({ browser_push_enabled: true });
      toast("浏览器推送已开启");
    } catch (err) {
      // 任一步失败不改变既有渠道（邮件/站内零影响）
      const message = err instanceof Error ? err.message : "未知错误";
      toast(`开启失败：${message}（邮件与站内事件不受影响）`);
    }
    await renderPush();
  }

  /** 「关闭」：unsubscribe → DELETE 订阅 → enabled=0（401 按 api.ts 既有跳转） */
  async function disablePush(): Promise<void> {
    if (DEMO_PUSH) {
      toast("演示环境未真实订阅，无需关闭");
      return;
    }
    const api = await loadApi();
    try {
      const subscription = await readSubscription();
      if (subscription) await subscription.unsubscribe();
      const subId = window.localStorage.getItem(PUSH_SUB_ID_KEY);
      if (subId) {
        try {
          await api.deletePushSubscription(subId);
        } catch (err) {
          // 服务端已清理（404）不算失败；其他错误上抛
          if (!(err instanceof api.ApiError && err.status === 404)) throw err;
        }
        window.localStorage.removeItem(PUSH_SUB_ID_KEY);
      }
      await api.patchNotificationPreferences({ browser_push_enabled: false });
      toast("浏览器推送已关闭（邮件与站内事件不受影响）");
    } catch (err) {
      const message = err instanceof Error ? err.message : "未知错误";
      toast(`关闭失败：${message}`);
    }
    await renderPush();
  }

  pushBtn?.addEventListener("click", () => {
    if (pushBtn.textContent === "关闭") void disablePush();
    else void enablePush();
  });

  // ===== 覆盖申请（本地演示，诚实确认） =====
  const applyForm = document.querySelector<HTMLFormElement>("[data-apply-form]");
  const applyDone = document.querySelector<HTMLElement>("[data-apply-done]");

  applyForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const cityInput = document.querySelector<HTMLInputElement>("[data-apply-city]");
    const city = cityInput?.value.trim() ?? "";
    const error = document.querySelector<HTMLElement>("[data-apply-error]");
    if (!city) {
      error?.classList.add("is-shown");
      cityInput?.focus();
      return;
    }
    error?.classList.remove("is-shown");
    const object = document.querySelector<HTMLInputElement>("[data-apply-object]")?.value.trim() ?? "";
    const summary = document.querySelector<HTMLElement>("[data-apply-summary]");
    if (summary) summary.textContent = object ? `${city} · ${object}` : city;
    applyForm.classList.add("is-hidden");
    applyDone?.classList.remove("is-hidden");
    toast("覆盖申请已记录（演示，未真实提交）");
  });

  document.querySelector<HTMLButtonElement>("[data-apply-again]")?.addEventListener("click", () => {
    applyForm?.reset();
    applyForm?.classList.remove("is-hidden");
    applyDone?.classList.add("is-hidden");
  });

  // ===== 导出个人数据（TASK-07B：POST /me/export JSON 单文件） =====
  document
    .querySelector<HTMLButtonElement>("[data-export]")
    ?.addEventListener("click", () => {
      void (async () => {
        const { exportData, ApiError } = await loadApi();
        try {
          const data = await exportData();
          const date = new Date().toISOString().slice(0, 10);
          const blob = new Blob([JSON.stringify(data, null, 2)], {
            type: "application/json",
          });
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = `property-radar-export-${date}.json`;
          document.body.appendChild(a);
          a.click();
          a.remove();
          URL.revokeObjectURL(url);
          toast("导出完成：已开始下载个人数据 JSON");
        } catch (err) {
          if (err instanceof ApiError && err.status === 401) {
            toast("请先登录云端账号后再导出");
          } else {
            toast(`导出失败：${err instanceof Error ? err.message : String(err)}`);
          }
        }
      })();
    });

  // ===== 二次确认 / 暂未开放 =====
  window.addEventListener("app:confirm", (event) => {
    const detail = (event as CustomEvent<{ id: string }>).detail;
    if (detail.id === "account-clear") {
      window.localStorage.removeItem("pr:favorites");
      toast("已删除本设备的本地收藏");
    }
    if (detail.id === "account-delete") {
      void (async () => {
        const { deleteAccount, ApiError } = await loadApi();
        try {
          const res = await deleteAccount();
          toast(
            `已提交注销：会话即时失效，${res.purge_after_days} 天内重新登录可撤销，到期云端数据永久删除`,
          );
        } catch (err) {
          if (err instanceof ApiError && err.status === 401) {
            toast("请先登录云端账号后再注销");
          } else {
            toast(`注销失败：${err instanceof Error ? err.message : String(err)}`);
          }
        }
        // 本设备演示登录态与缓存一并清理（云端数据由注销流程处理）
        window.localStorage.removeItem(EMAIL_KEY);
        // TASK-01C：注销同样触发私有客户端缓存清理
        void (
          window as unknown as { __prPurgePrivateCache?: () => Promise<void> }
        ).__prPurgePrivateCache?.();
        renderSession();
      })();
    }
  });

  document.addEventListener("click", (event) => {
    const soon = (event.target as HTMLElement).closest<HTMLElement>("[data-soon]");
    if (soon) {
      toast(`「${soon.dataset.soon ?? ""}」暂未开放，将在后续任务实现`);
    }
  });
</script>

