---
/**
 * 小区详情 `/community?id=`（PRD 2.5）：
 * 主卡（口径+日期+样本量+状态）→ 分位与样本变化 → 趋势图（周期切换）→
 * 数据来源 → 设定目标价 / 加入监控（游客 → Permission 引导）。
 * 低样本对象降级展示；采集失败对象显示 ErrorState（可重试），绝不虚构价格。
 */
import AppShell from "../layouts/AppShell.astro";
import EmptyState from "../components/EmptyState.astro";
import PriceMetricCard from "../components/PriceMetricCard.astro";
import SampleCountLabel from "../components/SampleCountLabel.astro";
import SourceAttribution from "../components/SourceAttribution.astro";
import DataFreshnessBadge from "../components/DataFreshnessBadge.astro";
import StaleDataNotice from "../components/StaleDataNotice.astro";
import ErrorState from "../components/ErrorState.astro";
import ConfirmDialog from "../components/ConfirmDialog.astro";
import { PERIOD_LABELS } from "../scripts/chart";

const demoEnabled = import.meta.env.PUBLIC_DEMO_DATA === "1";
const demo = demoEnabled ? (await import("../data/demo")).demoData : null;

const periodKeys = ["30", "90", "180"];

const chartMap: Record<string, Record<string, Record<string, number[]>>> = {};
if (demo) {
  for (const community of demo.communities) {
    chartMap[community.id] = { list: community.series };
  }
}
const chartJson = JSON.stringify(chartMap);

const statusBadge = (status: string) =>
  status === "stale"
    ? { text: "数据延迟", cls: "badge--warning" }
    : status === "low"
      ? { text: "样本有限", cls: "badge--warning" }
      : status === "none"
        ? { text: "数据不足", cls: "badge--neutral" }
        : { text: "数据正常", cls: "badge--down" };
---

<AppShell title="小区详情" activeTab="communities" demo={demoEnabled} backHref="/communities">
  {
    demo ? (
      <div class="page" data-chart-json={chartJson}>
        <div class="stack community-blocks">
          {demo.communities.map((community, index) => {
            const badge = statusBadge(community.status);
            const isFailed = community.status === "none";
            return (
              <section
                class:list={["community-detail", index !== 0 && "is-hidden"]}
                data-community-detail={community.id}
                aria-label={community.name}
              >
                <header class="card cd-head">
                  <div class="cd-title-row">
                    <h2 class="cd-name">{community.name}</h2>
                    <span class:list={["badge", badge.cls]}>{badge.text}</span>
                  </div>
                  <p class="meta">
                    {community.regionName} › {community.plate} · 样本质量分层
                  </p>
                  <div class="cd-badges">
                    <SampleCountLabel sample={community.sample} />
                    <DataFreshnessBadge
                      status={community.status === "stale" ? "stale" : "fresh"}
                      date={community.collectedAt}
                    />
                  </div>
                </header>

                {community.status === "stale" && (
                  <StaleDataNotice
                    source={community.source}
                    lastValid={community.statDate}
                    days={2}
                  />
                )}

                {isFailed ? (
                  /* 采集失败：错误状态 + 可重试（不显示静态假数据） */
                  <div data-error-area>
                    <ErrorState
                      message={`${community.name} 最近一次采集失败（演示源 502）。在源恢复前不展示任何价格数字。`}
                      retryKey={community.id}
                    />
                  </div>
                ) : (
                  <div class="cd-main">
                    <PriceMetricCard
                      metric="挂牌参考 · 小区中位价"
                      value={
                        community.median !== null
                          ? community.median.toLocaleString("zh-CN")
                          : "数据不足"
                      }
                      direction={community.direction}
                      percent={community.change30}
                      statDate={community.statDate}
                      sample={community.sample}
                      status={
                        community.status === "stale"
                          ? { text: "数据延迟", tone: "warning" }
                          : community.status === "low"
                            ? { text: "样本有限", tone: "warning" }
                            : { text: "数据正常", tone: "ok" }
                      }
                      footer={
                        community.median !== null
                          ? `较 30 日前的变化（同口径）；低样本对象不纳入自动对标。`
                          : "样本少于 5 套，不发布代表性价格。"
                      }
                    />

                    {community.median !== null && (
                      <div class="grid-2 cd-stats">
                        <div class="cd-stat">
                          <span class="cd-stat-label">均价</span>
                          <span class="cd-stat-value num">
                            {community.avg?.toLocaleString("zh-CN")} 元/㎡
                          </span>
                        </div>
                        <div class="cd-stat">
                          <span class="cd-stat-label">P25</span>
                          <span class="cd-stat-value num">
                            {community.p25?.toLocaleString("zh-CN")} 元/㎡
                          </span>
                        </div>
                        <div class="cd-stat">
                          <span class="cd-stat-label">P75</span>
                          <span class="cd-stat-value num">
                            {community.p75?.toLocaleString("zh-CN")} 元/㎡
                          </span>
                        </div>
                        <div class="cd-stat">
                          <span class="cd-stat-label">有效样本</span>
                          <span class="cd-stat-value num">{community.sample} 套</span>
                        </div>
                      </div>
                    )}

                    {/* 口径切换：暂不支持的口径显式说明 */}
                    <div class="chip-row" role="group" aria-label="价格口径切换">
                      <button
                        type="button"
                        class="chip is-active"
                        data-community-metric="list"
                        aria-pressed="true"
                      >
                        挂牌参考
                      </button>
                      <button
                        type="button"
                        class="chip"
                        data-community-metric="deal"
                        aria-pressed="false"
                      >
                        实际成交
                      </button>
                      <button type="button" class="chip" data-soon="官方指数口径">
                        官方指数
                        <span class="badge badge--neutral">暂未开放</span>
                      </button>
                    </div>
                    <div class="cd-metric-note meta is-hidden" data-metric-note />

                    <figure class="cd-chart-wrap" data-community-chart>
                      <svg
                        class="cd-chart"
                        viewBox="0 0 100 72"
                        preserveAspectRatio="none"
                        data-chart
                        role="img"
                        aria-label="小区价格趋势图"
                      >
                        <line
                          x1="0"
                          y1="71"
                          x2="100"
                          y2="71"
                          stroke="var(--color-border)"
                          stroke-width="1"
                          vector-effect="non-scaling-stroke"
                        />
                        <path
                          data-chart-path
                          d=""
                          fill="none"
                          stroke="var(--color-primary)"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          vector-effect="non-scaling-stroke"
                        />
                        <circle data-chart-dot cx="0" cy="0" r="0" fill="var(--color-primary)" />
                      </svg>
                      <figcaption class="meta" data-chart-caption />
                    </figure>

                    <div class="chip-row" data-period-row role="group" aria-label="趋势周期">
                      {periodKeys.map((period) => (
                        <button
                          type="button"
                          class:list={["chip", period === "30" && "is-active"]}
                          data-period={period}
                          aria-pressed={period === "30" ? "true" : "false"}
                        >
                          {PERIOD_LABELS[period]}
                        </button>
                      ))}
                    </div>

                    <div class="card cd-sample-change">
                      <p class="cd-subtitle">样本变化（近 30 日）</p>
                      <div class="cd-sample-row">
                        <span class="badge badge--neutral">
                          新上 <span class="num">+{community.sampleDelta.added}</span>
                        </span>
                        <span class="badge badge--warning">
                          降价 <span class="num">-{community.sampleDelta.reduced}</span>
                        </span>
                        <span class="badge badge--neutral">
                          下架 <span class="num">-{community.sampleDelta.removed}</span>
                        </span>
                      </div>
                      <p class="meta">
                        样本变化说明供给与降价压力，不等同于价格指数。
                      </p>
                    </div>
                  </div>
                )}

                <SourceAttribution
                  metric="挂牌参考 · 小区中位价"
                  source={community.source}
                  statDate={community.statDate}
                  collectedAt={community.collectedAt}
                  quality={community.quality}
                />

                <div class="btn-row">
                  <a class="btn btn--primary" href={`/rules?target=${encodeURIComponent(community.id)}`}>
                    设定目标价
                  </a>
                  <button
                    type="button"
                    class="btn btn--secondary"
                    data-dialog-open="perm-watch"
                  >
                    加入监控
                  </button>
                </div>
              </section>
            );
          })}
        </div>

        <ConfirmDialog
          id="perm-watch"
          title="云端监控需要登录"
          message="游客可本地浏览与设定目标价草案；注册登录后云端保存监控并推送事件（不依赖浏览器推送权限）。"
          confirmText="去登录"
          cancelText="继续浏览"
        />
      </div>
    ) : (
      <div class="page" data-prod-community>
        <p class="meta is-hidden" data-cd-loading>正在加载小区数据…</p>

        <div class="stack community-blocks is-hidden" data-cd-card>
          <section class="community-detail" aria-label="小区详情">
            <header class="card cd-head">
              <div class="cd-title-row">
                <h2 class="cd-name" data-cd-name>—</h2>
                <span class="badge badge--neutral" data-cd-freshness>—</span>
              </div>
              <p class="meta" data-cd-path></p>
              <div class="cd-badges" data-cd-badges></div>
            </header>

            <div class="cd-main" data-cd-metrics></div>

            <figure class="cd-chart-wrap" data-cd-chart-wrap>
              <svg
                class="cd-chart"
                viewBox="0 0 100 72"
                preserveAspectRatio="none"
                data-cd-chart
                role="img"
                aria-label="小区价格趋势图"
              >
                <line
                  x1="0"
                  y1="71"
                  x2="100"
                  y2="71"
                  stroke="var(--color-border)"
                  stroke-width="1"
                  vector-effect="non-scaling-stroke"
                />
                <path
                  data-cd-chart-path
                  d=""
                  fill="none"
                  stroke="var(--color-primary)"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  vector-effect="non-scaling-stroke"
                />
                <circle
                  data-cd-chart-dot
                  cx="0"
                  cy="0"
                  r="0"
                  fill="var(--color-primary)"
                />
              </svg>
              <figcaption class="meta" data-cd-chart-caption></figcaption>
            </figure>

            <div class="card cd-sample-change" data-cd-history-wrap>
              <p class="cd-subtitle">历史快照</p>
              <div class="stack-sm" data-cd-history></div>
            </div>

            <p class="meta" data-cd-source></p>

            <div class="btn-row">
              <a class="btn btn--primary" href="/rules" data-cd-rules>
                设定目标价
              </a>
              <button
                type="button"
                class="btn btn--secondary"
                data-dialog-open="perm-watch"
              >
                加入监控
              </button>
            </div>
          </section>
        </div>

        <div class="is-hidden" data-cd-empty>
          <EmptyState
            title="未找到该小区"
            description="链接可能已过期，或该小区不在当前城市目录中；请从小区搜索页重新选择。"
            actionText="返回小区搜索"
            actionHref="/communities"
          />
        </div>

        <div class="is-hidden" data-cd-error>
          <EmptyState
            title="小区数据加载失败"
            description="无法连接数据服务；恢复之前不会展示任何价格数字。"
          >
            <button type="button" class="btn btn--secondary" data-cd-retry>
              重新加载
            </button>
          </EmptyState>
        </div>

        <ConfirmDialog
          id="perm-watch"
          title="云端监控需要登录"
          message="游客可浏览全部公开数据；设定目标价与监控事件推送需注册登录。"
          confirmText="去登录"
          cancelText="继续浏览"
        />
      </div>
    )
  }
</AppShell>

<script>
  import { PERIOD_LABELS, drawChart, parseChartData } from "../scripts/chart";

  const data = parseChartData(
    document.querySelector<HTMLElement>("[data-chart-json]")?.dataset.chartJson ?? "{}",
  );

  const params = new URLSearchParams(window.location.search);
  let communityId = params.get("id") ?? "";
  if (!data[communityId]) communityId = Object.keys(data)[0] ?? "";

  let period = "30";

  const redraw = () => {
    const block = document.querySelector<HTMLElement>(
      `[data-community-detail="${CSS.escape(communityId)}"]`,
    );
    if (!block) return;
    const svg = block.querySelector<SVGSVGElement>("[data-chart]");
    const caption = block.querySelector<HTMLElement>("[data-chart-caption]");
    const points = data[communityId]?.["list"]?.[period] ?? [];
    if (svg) drawChart(svg, points);
    if (caption) {
      caption.textContent = `挂牌参考 · 中位价 · ${PERIOD_LABELS[period] ?? period} · 数据来源 演示数据源 · 统计日期 2026-11-10`;
    }
  };

  const applyCommunity = (id: string, updateUrl: boolean) => {
    if (!data[id]) return;
    communityId = id;
    document.querySelectorAll<HTMLElement>("[data-community-detail]").forEach((block) => {
      block.classList.toggle("is-hidden", (block.dataset.communityDetail ?? "") !== id);
    });
    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set("id", id);
      window.history.replaceState({}, "", url);
    }
    redraw();
  };

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;

    const periodChip = target.closest<HTMLElement>("[data-period]");
    if (periodChip) {
      period = periodChip.dataset.period ?? "30";
      document
        .querySelectorAll<HTMLElement>(`[data-community-detail="${CSS.escape(communityId)}"] [data-period]`)
        .forEach((chip) => {
          const active = chip.dataset.period === period;
          chip.classList.toggle("is-active", active);
          chip.setAttribute("aria-pressed", active ? "true" : "false");
        });
      redraw();
      return;
    }

    const metricChip = target.closest<HTMLElement>("[data-community-metric]");
    if (metricChip) {
      const note = document.querySelector<HTMLElement>("[data-metric-note]");
      document
        .querySelectorAll<HTMLElement>("[data-community-metric]")
        .forEach((chip) => {
          const active = chip === metricChip;
          chip.classList.toggle("is-active", active);
          chip.setAttribute("aria-pressed", active ? "true" : "false");
        });
      if (note) {
        if (metricChip.dataset.communityMetric === "deal") {
          note.textContent =
            "实际成交口径需数据授权，该对象暂无授权成交数据（不以挂牌数字顶替）。";
          note.classList.remove("is-hidden");
        } else {
          note.textContent = "";
          note.classList.add("is-hidden");
        }
      }
      // 无授权口径时不展示挂牌趋势图，避免口径混淆
      const showChart = metricChip.dataset.communityMetric !== "deal";
      document
        .querySelectorAll<HTMLElement>("[data-community-chart], [data-period-row]")
        .forEach((el) => el.classList.toggle("is-hidden", !showChart));
      return;
    }

    const soon = target.closest<HTMLElement>("[data-soon]");
    if (soon) {
      window.dispatchEvent(
        new CustomEvent("app:toast", {
          detail: { message: `「${soon.dataset.soon ?? ""}」暂未开放，将在后续任务实现` },
        }),
      );
    }
  });

  // 采集失败对象的重试：短暂骨架 → 明确仍失败（不假装成功）
  window.addEventListener("app:retry", (event) => {
    const detail = (event as CustomEvent<{ key: string }>).detail;
    const area = document.querySelector<HTMLElement>("[data-error-area]");
    if (!area) return;
    const original = area.innerHTML;
    area.innerHTML =
      '<div class="card" aria-busy="true"><p class="meta">正在重新采集…</p><div class="skeleton" style="height:14px;width:70%;margin-top:8px"></div><div class="skeleton" style="height:14px;width:45%;margin-top:8px"></div></div>';
    window.setTimeout(() => {
      area.innerHTML = original;
      window.dispatchEvent(
        new CustomEvent("app:toast", {
          detail: { message: `重试后源仍不可用（${detail.key}）：保持错误状态展示` },
        }),
      );
    }, 900);
  });

  window.addEventListener("app:confirm", (event) => {
    const detail = (event as CustomEvent<{ id: string }>).detail;
    if (detail.id === "perm-watch") window.location.href = "/login";
  });

  applyCommunity(communityId, false);

  // ===== TASK-08C R5：生产小区详情（GET /public/communities/:id + /prices） =====
  const prodRoot = document.querySelector<HTMLElement>("[data-prod-community]");
  if (prodRoot) {
    const { ApiError, getCommunity, getCommunityPrices, searchRegions } =
      await import("../lib/api");
    const {
      SAMPLE_TIER_TEXT,
      formatPriceValue,
      freshnessStatus,
      isLowSample,
      latestPerMetric,
      metricLabel,
      priceTypeLabel,
      sampleTier,
      trendSeries,
    } = await import("../lib/market");

    const loadingEl = prodRoot.querySelector<HTMLElement>("[data-cd-loading]");
    const cardEl = prodRoot.querySelector<HTMLElement>("[data-cd-card]");
    const emptyEl = prodRoot.querySelector<HTMLElement>("[data-cd-empty]");
    const errorEl = prodRoot.querySelector<HTMLElement>("[data-cd-error]");

    const show = (target: "loading" | "card" | "empty" | "error") => {
      loadingEl?.classList.toggle("is-hidden", target !== "loading");
      cardEl?.classList.toggle("is-hidden", target !== "card");
      emptyEl?.classList.toggle("is-hidden", target !== "empty");
      errorEl?.classList.toggle("is-hidden", target !== "error");
    };

    const QUALITY_TEXT: Record<string, string> = {
      valid: "质量正常",
      suspect: "质量待核",
      stale: "质量过期",
    };

    const detailId = new URLSearchParams(window.location.search).get("id") ?? "";

    const load = async () => {
      if (!detailId) {
        emptyEl?.querySelector("h2")?.replaceChildren("请从小区搜索页选择小区");
        show("empty");
        return;
      }
      show("loading");
      try {
        const [{ community }, pricesRes] = await Promise.all([
          getCommunity(detailId),
          getCommunityPrices(detailId, 50),
        ]);
        const regions = await searchRegions(community.city_code).catch(() => null);
        const districtName =
          regions?.items.find((r) => r.region_id === community.region_id)?.name ??
          community.region_id;

        prodRoot.querySelector("[data-cd-name]")!.textContent = community.name;
        prodRoot.querySelector("[data-cd-path]")!.textContent =
          `${community.city_code} › ${districtName}${community.block_name ? ` · ${community.block_name}` : ""}${
            community.built_year ? ` · 建成 ${community.built_year}` : ""
          }`;
        prodRoot
          .querySelector("[data-cd-rules]")!
          .setAttribute("href", `/rules?target=${encodeURIComponent(community.community_id)}`);

        const items = pricesRes.items;
        const latest = latestPerMetric(items);
        const main =
          latest.find((s) => s.metric_code === "median_price" && s.median !== null) ??
          latest[0] ??
          null;

        // 徽标区：样本分层 + 新鲜度
        const badgesHost = prodRoot.querySelector("[data-cd-badges]")!;
        badgesHost.replaceChildren();
        if (main) {
          const sampleBadge = document.createElement("span");
          sampleBadge.className = "badge badge--neutral";
          sampleBadge.textContent = `${SAMPLE_TIER_TEXT[sampleTier(main.sample_count)]} · ${main.sample_count ?? 0} 条`;
          badgesHost.append(sampleBadge);
        }
        const fresh = freshnessStatus(main?.stat_date ?? null, Date.now());
        const freshBadge = prodRoot.querySelector("[data-cd-freshness]")!;
        if (!main) {
          freshBadge.textContent = "暂无数据";
          freshBadge.className = "badge badge--neutral";
        } else {
          freshBadge.textContent =
            fresh === "fresh" ? "数据正常" : fresh === "delayed" ? "更新延迟" : "数据过期";
          freshBadge.className = `badge ${fresh === "fresh" ? "badge--down" : "badge--warning"}`;
        }

        // 主指标卡：中位/均价/P25/P75/样本（全部来自快照字段，缺失显示 —）
        const metricsHost = prodRoot.querySelector("[data-cd-metrics]")!;
        metricsHost.replaceChildren();
        if (main) {
          const hero = document.createElement("div");
          hero.className = "card prod-cd-hero";
          hero.innerHTML = `
            <p class="meta" data-metric></p>
            <div class="prod-cd-hero-value"><span class="num" data-v></span><span class="meta" data-date></span></div>`;
          hero.querySelector("[data-metric]")!.textContent =
            `${metricLabel(main.metric_code)} · ${priceTypeLabel(main.price_type)}`;
          const vEl = hero.querySelector("[data-v]")!;
          vEl.textContent = formatPriceValue(main.median, "元/㎡");
          if (isLowSample(main.sample_count)) vEl.classList.add("prod-cd-hero-weak");
          hero.querySelector("[data-date]")!.textContent =
            `数据日期 ${main.stat_date.slice(0, 10)} · 采集 ${main.collected_at?.slice(0, 16) ?? "—"}`;
          metricsHost.append(hero);

          const grid = document.createElement("div");
          grid.className = "grid-2 cd-stats";
          for (const [label, value] of [
            ["均价", main.mean],
            ["P25", main.p25],
            ["P75", main.p75],
            ["有效样本", main.sample_count],
          ] as const) {
            const cell = document.createElement("div");
            cell.className = "cd-stat";
            const l = document.createElement("span");
            l.className = "cd-stat-label";
            l.textContent = label;
            const v = document.createElement("span");
            v.className = "cd-stat-value num";
            v.textContent =
              label === "有效样本"
                ? `${value ?? "—"} 条`
                : formatPriceValue(value as number | null, "元/㎡");
            cell.append(l, v);
            grid.append(cell);
          }
          metricsHost.append(grid);
        } else {
          const note = document.createElement("p");
          note.className = "meta";
          note.textContent = "该小区尚无有效价格快照；不展示任何估算数字。";
          metricsHost.append(note);
        }

        // 趋势图：中位价历史序列（升序）；不足 2 点如实说明
        const chartWrap = prodRoot.querySelector("[data-cd-chart-wrap]")!;
        const series = trendSeries(items, "median_price", main?.price_type ?? null).filter(
          (s) => s.median !== null,
        );
        if (series.length >= 2) {
          chartWrap.classList.remove("is-hidden");
          const svg = prodRoot.querySelector<SVGSVGElement>("[data-cd-chart]")!;
          drawChart(svg, series.map((s) => s.median as number));
          const first = series[0]!;
          const last = series[series.length - 1]!;
          const delta =
            first.median && last.median
              ? `${(((last.median - first.median) / first.median) * 100).toFixed(1)}%`
              : "—";
          prodRoot.querySelector("[data-cd-chart-caption]")!.textContent =
            `${metricLabel("median_price")} · ${priceTypeLabel(main?.price_type ?? null)} · ${series.length} 个快照（${first.stat_date.slice(0, 10)} → ${last.stat_date.slice(0, 10)}）· 区间变化 ${delta}`;
        } else {
          chartWrap.classList.add("is-hidden");
        }

        // 历史快照列表（近 10 条）
        const historyHost = prodRoot.querySelector("[data-cd-history]")!;
        const historyWrap = prodRoot.querySelector("[data-cd-history-wrap]")!;
        if (items.length === 0) {
          historyWrap.classList.add("is-hidden");
        } else {
          historyWrap.classList.remove("is-hidden");
          const fragment = document.createDocumentFragment();
          for (const s of items.slice(0, 10)) {
            const row = document.createElement("div");
            row.className = "card prod-cd-history-row";
            const date = document.createElement("span");
            date.className = "num";
            date.textContent = s.stat_date.slice(0, 10);
            const metric = document.createElement("span");
            metric.className = "meta";
            metric.textContent = `${metricLabel(s.metric_code)} · ${priceTypeLabel(s.price_type)}`;
            const value = document.createElement("span");
            value.className = "num prod-cd-history-value";
            value.textContent = formatPriceValue(s.median, "元/㎡");
            if (isLowSample(s.sample_count)) value.classList.add("prod-cd-hero-weak");
            const sample = document.createElement("span");
            sample.className = "badge badge--neutral";
            sample.textContent = QUALITY_TEXT[s.quality_status] ?? s.quality_status;
            row.append(date, metric, value, sample);
            fragment.append(row);
          }
          historyHost.replaceChildren(fragment);
        }

        // 来源标注（SourceAttribution 口径）
        prodRoot.querySelector("[data-cd-source]")!.textContent = main?.source_id
          ? `来源：${main.source_id} · 方法版本 ${main.method_version ?? "—"} · ${QUALITY_TEXT[main.quality_status] ?? main.quality_status}；口径与许可详见数据说明页。`
          : "口径与许可详见数据说明页。";

        show("card");
      } catch (error) {
        if (error instanceof ApiError && error.status === 404) show("empty");
        else show("error");
      }
    };

    prodRoot
      .querySelector<HTMLButtonElement>("[data-cd-retry]")
      ?.addEventListener("click", () => void load());
    void load();
  }
</script>

