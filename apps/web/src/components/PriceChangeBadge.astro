---
/**
 * PriceChangeBadge：价格涨跌徽标——三重编码（箭头 + 文字 + 数值）。
 * PRD 硬性要求：颜色不得作为唯一信息编码，涨跌必须同时给出箭头、文字和数值。
 */
interface Props {
  direction: "up" | "down" | "flat";
  /** 变化率百分比数值（不带 % 符号） */
  percent?: number;
  /** 可选的绝对变化金额文案，如 "-920 元/㎡" */
  amount?: string;
  size?: "sm" | "md";
}

const { direction, percent, amount, size = "md" } = Astro.props;

const text = direction === "up" ? "上涨" : direction === "down" ? "下降" : "持平";
const cls = direction === "up" ? "up" : direction === "down" ? "down" : "flat";
const abs = percent === undefined ? "" : `${Math.abs(percent).toFixed(1)}%`;
const label =
  percent === undefined
    ? `${text}${amount ? ` ${amount}` : ""}`
    : `${text} ${abs}${amount ? `（${amount}）` : ""}`;
---

<span class:list={["change", `change--${cls}`, `change--${size}`]} role="img" aria-label={label}>
  {
    direction === "flat" ? (
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
        <path d="M2 6h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    ) : (
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
        <path
          d={direction === "up" ? "M6 2 L10 8 L2 8 Z" : "M6 10 L2 4 L10 4 Z"}
          fill="currentColor"
        />
      </svg>
    )
  }
  <span class="change-text">{text}</span>
  {abs && <span class="change-value num">{abs}</span>}
  {amount && <span class="change-amount num">{amount}</span>}
</span>

<style>
  .change {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    line-height: 1.3;
    white-space: nowrap;
  }

  .change--sm {
    font-size: var(--text-sm);
  }

  /* 上涨 = --color-up；下降 = --color-down；仅作强调，文字与箭头始终同时存在 */
  .change--up {
    color: var(--color-up);
  }

  .change--down {
    color: var(--color-down);
  }

  .change--flat {
    color: var(--color-neutral);
  }

  .change-value {
    font-weight: var(--weight-bold);
  }

  .change-amount {
    color: var(--color-muted);
    font-weight: var(--weight-regular);
    font-size: var(--text-sm);
  }
</style>
