---
/**
 * LoadingSkeleton：骨架屏（Loading 状态，禁止用空白页代替）。
 */
interface Props {
  variant?: "card" | "list" | "chart" | "line";
  count?: number;
}

const { variant = "card", count = 1 } = Astro.props;
---

<div class="skeleton-group" aria-hidden="true">
  {
    Array.from({ length: count }).map(() =>
      variant === "list" ? (
        <div class="sk sk-list card">
          <div class="skeleton sk-title" />
          <div class="skeleton sk-line" />
          <div class="skeleton sk-line sk-line--short" />
        </div>
      ) : variant === "chart" ? (
        <div class="sk card">
          <div class="skeleton sk-title" />
          <div class="skeleton sk-chart" />
        </div>
      ) : variant === "line" ? (
        <div class="skeleton sk-line" />
      ) : (
        <div class="sk card">
          <div class="skeleton sk-title" />
          <div class="skeleton sk-big" />
          <div class="skeleton sk-line" />
        </div>
      ),
    )
  }
</div>
<span class="sr-only">内容加载中…</span>

<style>
  .skeleton-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .sk {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sk-title {
    width: 40%;
    height: 14px;
  }

  .sk-big {
    width: 60%;
    height: 28px;
  }

  .sk-line {
    width: 100%;
    height: 12px;
  }

  .sk-line--short {
    width: 65%;
  }

  .sk-chart {
    width: 100%;
    height: 72px;
  }
</style>
