---
/**
 * CityScopeBadge：当前城市徽标 + 标准城市选择器（可检索、可多选收藏、可申请覆盖）。
 * - 真实城市目录来自 config/cities/city-catalog.json（337 城，全部 status=requestable），
 *   仅作选择器元数据，绝不携带价格；未覆盖城市不得填充假数据。
 * - 演示构建下初始城市为虚构的“演示市”（已开通 · 可监控）。
 */
import catalog from "../../../../config/cities/city-catalog.json";

interface Props {
  /** 实例标识（同页仅应存在一个带选择器的徽标） */
  id?: string;
  compact?: boolean;
}

const { id = "main", compact = false } = Astro.props;
const demoEnabled = import.meta.env.PUBLIC_DEMO_DATA === "1";

const initialName = demoEnabled ? "演示市" : "未选择城市";
const initialStatus = demoEnabled ? "已开通 · 可监控" : "337 城可申请";
const initialTone = demoEnabled ? "badge--primary" : "badge--neutral";

const cities = catalog.cities.map((city) => ({
  name: city.name,
  province: city.province_name,
  status: city.status,
}));
---

<button
  type="button"
  class:list={["city-badge", compact && "city-badge--compact"]}
  data-city-open={id}
  aria-label="切换当前城市"
>
  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" class="pin">
    <path
      d="M7 1.8a4 4 0 0 0-4 4c0 2.9-1.7 4.4-1.7 4.4h11.4S11 8.7 11 5.8a4 4 0 0 0-4-4Z"
      stroke="currentColor"
      stroke-width="1.4"
      fill="none"
      stroke-linejoin="round"
    />
    <circle cx="7" cy="5.7" r="1.5" fill="currentColor" />
  </svg>
  <span class="city-name" data-city-current>{initialName}</span>
  <span class:list={["badge", initialTone, "city-status"]} data-city-status>{initialStatus}</span>
</button>

<dialog class="city-dialog" data-city-dialog={id} aria-label="选择城市">
  <div class="dialog-head">
    <h2 class="dialog-title">选择城市</h2>
    <button type="button" class="icon-x" data-city-close aria-label="关闭城市选择">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <p class="meta dialog-note">
    标准城市目录共 {cities.length} 城，可检索与收藏；城市可选择 ≠ 已接入房价数据，未覆盖城市
    <strong>不填充任何假数据</strong>，仅提供覆盖申请入口。
  </p>
  <input
    type="search"
    class="input"
    data-city-search
    placeholder="搜索城市名，如：青岛市"
    aria-label="搜索城市"
  />
  <div class="city-list" data-city-list>
    {
      demoEnabled && (
        <button
          type="button"
          class="city-option"
          data-city-pick="演示市"
          data-city-status-value="active"
        >
          <span class="city-option-name">演示市（演示）</span>
          <span class="badge badge--primary">已开通 · 可监控</span>
        </button>
      )
    }
    {
      cities.map((city) => (
        <button
          type="button"
          class="city-option"
          data-city-pick={city.name}
          data-city-status-value={city.status}
        >
          <span class="city-option-name">
            {city.name}
            <span class="city-province">{city.province}</span>
          </span>
          <span class="badge badge--neutral">未覆盖 · 可申请</span>
        </button>
      ))
    }
    <p class="empty-tip is-hidden" data-city-empty>
      未找到匹配城市。目录外城市可走“申请补录城市目录”，不会创建虚构城市代码。
    </p>
  </div>
</dialog>

<script>
  // 城市选择器：打开/关闭、关键词过滤、切换城市（更新所有徽标 + 提示）
  const openPicker = () => {
    const dialog = document.querySelector<HTMLDialogElement>("dialog[data-city-dialog]");
    if (dialog && !dialog.open) dialog.showModal();
  };

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;

    if (target.closest("[data-city-open]")) {
      openPicker();
      return;
    }
    if (target.closest("[data-city-close]")) {
      (target.closest("dialog") as HTMLDialogElement | null)?.close();
      return;
    }

    const pick = target.closest<HTMLElement>("[data-city-pick]");
    if (pick) {
      const name = pick.dataset.cityPick ?? "";
      const status = pick.dataset.cityStatusValue ?? "requestable";
      const isActive = status === "active" || status === "limited";

      document.querySelectorAll("[data-city-current]").forEach((el) => {
        el.textContent = name;
      });
      document.querySelectorAll("[data-city-status]").forEach((el) => {
        const badge = el as HTMLElement;
        badge.textContent = isActive ? "已开通 · 可监控" : "未覆盖 · 可申请";
        badge.className = `badge city-status ${isActive ? "badge--primary" : "badge--neutral"}`;
      });

      (target.closest("dialog") as HTMLDialogElement | null)?.close();
      window.dispatchEvent(
        new CustomEvent("app:toast", {
          detail: {
            message: isActive
              ? `已切换到 ${name}`
              : `已切换到 ${name}：暂未覆盖房价数据，可提交覆盖申请（不展示假数据）`,
          },
        }),
      );
    }
  });

  // 城市名检索过滤
  const search = document.querySelector<HTMLInputElement>("[data-city-search]");
  const emptyTip = document.querySelector<HTMLElement>("[data-city-empty]");
  search?.addEventListener("input", () => {
    const query = search.value.trim();
    let visible = 0;
    document.querySelectorAll<HTMLElement>("[data-city-pick]").forEach((option) => {
      const matched = !query || (option.dataset.cityPick ?? "").includes(query);
      option.classList.toggle("is-hidden", !matched);
      if (matched) visible += 1;
    });
    emptyTip?.classList.toggle("is-hidden", visible > 0);
  });
</script>

<style>
  .city-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--hit-target);
    max-width: 220px;
    padding: 0 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .city-badge--compact {
    max-width: 150px;
    padding: 0 8px;
  }

  .city-badge:hover {
    border-color: var(--color-primary);
  }

  .pin {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .city-name {
    font-weight: var(--weight-semibold);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .city-status {
    flex-shrink: 0;
  }

  /* ===== 城市选择器弹层 ===== */
  .city-dialog {
    width: min(400px, calc(100vw - 32px));
    max-height: min(70vh, 560px);
    padding: var(--space-2);
    border: none;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-dialog);
    color: var(--color-text);
  }

  .city-dialog::backdrop {
    background: rgb(20 37 61 / 45%);
  }

  .dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .dialog-title {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    color: var(--color-brand-900);
  }

  .icon-x {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--hit-target);
    height: var(--hit-target);
    border: none;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
  }

  .dialog-note {
    margin-bottom: var(--space-1);
  }

  .city-list {
    margin-top: var(--space-1);
    overflow-y: auto;
    max-height: 46vh;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .city-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
    width: 100%;
    min-height: var(--hit-target);
    padding: 6px 10px;
    border: 1px solid transparent;
    border-radius: var(--radius-input);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    font-size: var(--text-sm);
    text-align: left;
    cursor: pointer;
  }

  .city-option:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .city-option-name {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
  }

  .city-province {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .empty-tip {
    padding: var(--space-2) 4px;
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.7;
  }
</style>
