{
  "name": "property-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint \"**/*.{ts,mjs}\" && prettier --check \"apps/**/*.{ts,mjs}\" \"packages/**/*.ts\" \"*.mjs\" \".github/**/*.yml\"",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r build",
    "format": "prettier --write \"apps/**/*.{ts,mjs}\" \"packages/**/*.ts\" \"*.mjs\" \".github/**/*.yml\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.20.0"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  }
}
