# 环境变量清单——只列名称，禁止填真实值（PRD 附录 A）
# 本地复制为 .env（已被 .gitignore 忽略）；生产用 wrangler secret put 配置

# ---- Cloudflare Worker Secrets ----
SESSION_SIGNING_SECRET=
INGEST_HMAC_SECRET=
TURNSTILE_SECRET_KEY=
APPS_SCRIPT_WEB_APP_URL=
APPS_SCRIPT_HMAC_SECRET=
# 未来迁移可选，未启用时不配置：
BREVO_API_KEY=
RESEND_API_KEY=
# V1 固定 google_apps_script_mail
EMAIL_PROVIDER=google_apps_script_mail
EMAIL_FROM=
# 首次创建管理员后立即撤销/删除
ADMIN_BOOTSTRAP_CODE=

# ---- 非敏感 Worker vars（不得作为 Secret 混淆）----
EMAIL_DAILY_HARD_CAP=80
OTP_DAILY_RESERVED_CAP=60
CITY_CATALOG_MODE=multi
# 城市状态与覆盖以 D1 城市目录为准，禁止硬编码单一城市

# ---- GitHub Actions Repository-level secrets（见 .github/workflows/ci.yml 注释）----
# INGEST_API_BASE_URL=
# INGEST_HMAC_SECRET=
# SOURCE_<SOURCE_CODE>_API_KEY=   仅授权来源需要
